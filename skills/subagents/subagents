cmd_protocol() {
	node - "$PROTOCOL_JSON" <<'NODE'
const fs = require("node:fs");
process.stdout.write(`${JSON.stringify(JSON.parse(fs.readFileSync(process.argv[2], "utf8")))}\n`);
NODE
}

cmd_config() {
	printf 'launcher=%s\n' "$PI_CMD"
	printf 'state_dir=%s\n' "$STATE_DIR"
	printf 'window_name=%s\n' "$WIN_PREFIX"
	printf 'cleanup_mode=%s\n' "$CLEANUP_MODE"
	printf 'cleanup_grace_seconds=%s\n' "$CLEANUP_GRACE_SECONDS"
	printf 'protocol_id=%s\n' "$PROTOCOL_ID"
	printf 'package_version=%s\n' "$PACKAGE_VERSION"
}

cmd_doctor() {
	local failures=0 warnings=0 orphan_sessions=0 root count dir name pane pane_session launcher_bin session_id
	local lock_path lock_label event_file
	session_id=$(current_session_id)
	root=$(sr)
	launcher_bin=$(launcher_binary)
	if [ -n "$launcher_bin" ] && command -v "$launcher_bin" >/dev/null 2>&1; then echo "ok   launcher: $launcher_bin"; else
		echo "FAIL launcher: command not found: ${launcher_bin:-<empty>}"; failures=$((failures + 1))
	fi
	count=$(subagents_windows "$session_id" | awk 'NF{n++} END{print n+0}')
	if [ "$count" -le 1 ]; then echo "ok   window: ${count} subagents window(s) in $session_id"; else
		echo "FAIL window: $count subagents windows in $session_id (expected at most 1)"; failures=$((failures + 1))
	fi
	if ! valid_session_id "$session_id"; then echo "FAIL state: unexpected tmux session id '$session_id'"; failures=$((failures + 1)); fi
	for dir in "$STATE_DIR"/*/; do
		[ -d "$dir" ] || continue
		name=$(basename "$dir")
		if ! valid_session_id "$name"; then echo "FAIL state: unexpected root entry $dir"; failures=$((failures + 1)); continue; fi
		if ! tmux list-sessions -F '#{session_id}' 2>/dev/null | grep -Fqx "$name"; then orphan_sessions=$((orphan_sessions + 1)); fi
	done
	if [ "$orphan_sessions" -gt 0 ]; then echo "WARN state: $orphan_sessions orphaned tmux session dir(s) under $STATE_DIR"; warnings=$((warnings + 1)); fi
	for lock_path in "$root/.schema.lock" "$root/.seq.lock" "$root/.window.lock"; do
		case "$lock_path" in *.schema.lock) lock_label="state schema" ;; *.seq.lock) lock_label="sequence" ;; *) lock_label="tmux window" ;; esac
		if [ -e "$lock_path" ]; then
			if lock_owner_abandoned "$lock_path"; then echo "WARN state: abandoned $lock_label lock ($(lock_owner_description "$lock_path"))"; warnings=$((warnings + 1));
			elif ! lock_record_valid "$lock_path"; then echo "FAIL state: unsupported or invalid $lock_label lock at $lock_path"; failures=$((failures + 1)); fi
		fi
		if [ -e "$lock_path.recover" ]; then echo "WARN state: incomplete $lock_label lock recovery at $lock_path.recover"; warnings=$((warnings + 1)); fi
	done
	for dir in "$root"/*/; do
		[ -d "$dir" ] || continue
		name=$(basename "$dir")
		case "$name" in *[!0-9]*|'') echo "FAIL state: non-numeric agent dir $dir"; failures=$((failures + 1)); continue ;; esac
		if [ ! -s "$dir/pane" ] || [ ! -s "$dir/protocol.md" ] || [ ! -s "$dir/task" ] || [ ! -f "$dir/result.md" ]; then
			echo "FAIL state: incomplete agent dir $dir"; failures=$((failures + 1)); continue
		fi
		if ! node "$STATE_HELPER" validate "$dir/lifecycle.json" 2>/dev/null; then echo "FAIL state: invalid lifecycle for agent #$name"; failures=$((failures + 1)); fi
		lock_path="$dir/.event.lock"
		if [ -e "$lock_path" ]; then
			if lock_owner_abandoned "$lock_path"; then echo "WARN state: abandoned event lock for agent #$name ($(lock_owner_description "$lock_path"))"; warnings=$((warnings + 1));
			elif ! lock_record_valid "$lock_path"; then echo "FAIL state: invalid event lock at $lock_path"; failures=$((failures + 1)); fi
		fi
		[ ! -e "$lock_path.recover" ] || { echo "WARN state: incomplete event lock recovery for agent #$name"; warnings=$((warnings + 1)); }
		pane=$(cat "$dir/pane")
		pane_session=$(tmux display-message -pt "$pane" '#{session_id}' 2>/dev/null || true)
		if [ -z "$pane_session" ]; then echo "WARN state: agent #$name pane $pane is gone"; warnings=$((warnings + 1));
		elif [ "$pane_session" != "$session_id" ]; then echo "FAIL state: agent #$name pane belongs to $pane_session, not $session_id"; failures=$((failures + 1)); fi
	done
	for event_file in "$root"/.watcher-pending/*.json; do
		[ -f "$event_file" ] || continue
		if ! node "$STATE_HELPER" validate-event "$event_file" "$root" 2>/dev/null; then echo "FAIL state: malformed pending event $event_file"; failures=$((failures + 1)); fi
	done
	[ "$failures" -gt 0 ] || echo "ok   state: protocol $PROTOCOL_ID package $PACKAGE_VERSION at $root"
	if [ "$failures" -gt 0 ]; then echo "doctor: $failures failure(s), $warnings warning(s)"; return 1; fi
	if [ "$warnings" -gt 0 ]; then echo "doctor: healthy, $warnings warning(s)"; else echo "doctor: healthy"; fi
}

cmd_run() {
	local model_override="" effort_override="" task session_id id dir result temporary protocol pane picmd
	local inherited_provider="${PI_PROVIDER:-}" inherited_model="${PI_MODEL:-}" inherited_effort="${PI_REASONING_LEVEL:-}"
	local launch_model="" launch_effort="" launch_provider="" launch_model_id="" q_pwd q_proto q_task q_model q_effort q_provider q_model_id q_ready
	while [ $# -gt 0 ]; do
		case "$1" in
			-m|--model) [ $# -ge 2 ] && [ -n "$2" ] || die "$1 needs a value"; model_override="$2"; shift 2 ;;
			--effort) [ $# -ge 2 ] && [ -n "$2" ] || die "--effort needs a value"; effort_override="$2"; shift 2 ;;
			--) shift; break ;;
			-*) die "unknown option '$1'" ;;
			*) break ;;
		esac
	done
	task="$*"
	[ -n "$task" ] || die "usage: subagents run [-m MODEL] [--effort LEVEL] <task...>"
	if [ -n "$model_override" ] && ! provider_model "$model_override"; then die "model '$model_override' is not provider-qualified (expected provider/model)"; fi
	if [ -n "$effort_override" ] && ! valid_effort "$effort_override"; then die "invalid effort '$effort_override'"; fi
	run_doctor_preflight
	if [ -z "$model_override" ]; then
		if [ -n "$inherited_provider" ] || [ -n "$inherited_model" ]; then
			[ -n "$inherited_provider" ] && [ -n "$inherited_model" ] || die "PI_PROVIDER/PI_MODEL inheritance is incomplete"
			launch_model="$inherited_provider/$inherited_model"
			provider_model "$launch_model" || die "inherited PI_PROVIDER/PI_MODEL is invalid"
		fi
		if [ -z "$effort_override" ] && [ -n "$inherited_effort" ]; then
			valid_effort "$inherited_effort" || die "inherited PI_REASONING_LEVEL '$inherited_effort' is invalid"
			launch_effort="$inherited_effort"
		fi
	else
		launch_model="$model_override"
	fi
	[ -z "$effort_override" ] || launch_effort="$effort_override"
	if [ -n "$launch_model" ]; then
		launch_provider=${launch_model%%/*}; launch_model_id=${launch_model#*/}
		validate_model_id "$launch_model"
	fi

	session_id=$(current_session_id)
	id=$(reserve_id) || die "failed to reserve subagent id"
	dir=$(sadir "$id")
	result="$dir/result.md"
	temporary="$dir/report.next.md"
	: >"$result" || die "could not initialize report for subagent #$id"
	protocol="$dir/protocol.md"
	write_protocol "$id" "$result" "$temporary" 1 >"$protocol" || die "could not write protocol for subagent #$id"

	q_pwd=$(printf %q "$PWD"); q_proto=$(printf %q "$protocol"); q_task=$(printf %q "$task"); q_ready=$(printf %q "$dir/.launch-ready")
	picmd="cd $q_pwd && while [ ! -f $q_ready ]; do sleep 0.01; done && exec env -u PI_SESSION_ID -u PI_SESSION_FILE"
	[ -n "$launch_model" ] || picmd="$picmd -u PI_PROVIDER -u PI_MODEL"
	[ -n "$launch_effort" ] || picmd="$picmd -u PI_REASONING_LEVEL"
	if [ -n "$launch_model" ]; then
		q_provider=$(printf %q "$launch_provider"); q_model_id=$(printf %q "$launch_model_id")
		picmd="$picmd PI_PROVIDER=$q_provider PI_MODEL=$q_model_id"
	fi
	if [ -n "$launch_effort" ]; then q_effort=$(printf %q "$launch_effort"); picmd="$picmd PI_REASONING_LEVEL=$q_effort"; fi
	picmd="$picmd $PI_CMD --no-extensions --no-skills --no-prompt-templates --no-context-files --no-session"
	if [ -n "$launch_model" ]; then q_model=$(printf %q "$launch_model"); picmd="$picmd --model $q_model"; fi
	if [ -n "$launch_effort" ]; then picmd="$picmd --thinking $q_effort"; fi
	picmd="$picmd --append-system-prompt $q_proto $q_task"

	if ! pane=$(create_subagent_pane "$session_id" "$picmd") || [ -z "$pane" ]; then
		lifecycle_transition "$id" stopped >/dev/null 2>&1 || true
		die "failed to create subagent pane; state preserved at $dir"
	fi
	if ! printf '%s\n' "$pane" >"$dir/pane" || ! printf '%s\n' "$task" >"$dir/task"; then
		tmux kill-pane -t "$pane" 2>/dev/null || true
		lifecycle_transition "$id" stopped >/dev/null 2>&1 || true
		die "failed to persist launch state for subagent #$id; partial state preserved"
	fi
	if ! lifecycle_transition "$id" working >/dev/null; then
		tmux kill-pane -t "$pane" 2>/dev/null || true
		die "failed to activate lifecycle for subagent #$id; state preserved"
	fi
	if ! : >"$dir/.launch-ready"; then
		tmux kill-pane -t "$pane" 2>/dev/null || true
		lifecycle_transition "$id" stopped >/dev/null 2>&1 || true
		die "failed to release worker startup gate for subagent #$id; state preserved"
	fi
	sleep 0.2
	if ! pane_alive "$pane"; then
		lifecycle_transition "$id" stopped >/dev/null 2>&1 || true
		die "worker launcher exited during startup for subagent #$id; state preserved"
	fi
	tmux select-pane -t "$pane" -T "subagent#$id" 2>/dev/null || true
	echo "started subagent #$id — pane $pane, model ${launch_model:-launcher default}${launch_effort:+, effort $launch_effort}"
	echo "  report: pushed by subagents-watch — end your turn"
	echo "  answer: subagents tell $id <message>"
	echo "  fallback without watcher: subagents wait $id"
}

cmd_publish() {
	local id="${1:-}" outcome="${2:-}" source="${3:-}" requested_generation="${4:-}" dir lease state generation line rc
	[ -n "$id" ] && [ -n "$outcome" ] && [ -n "$source" ] && [ -n "$requested_generation" ] \
		|| die "usage: subagents publish <id> <completed|blocked> <report-file> <generation>"
	case "$outcome" in completed|blocked) ;; *) die "publish outcome must be completed or blocked" ;; esac
	case "$requested_generation" in ''|*[!0-9]*) die "publish generation must be a positive integer" ;; esac
	[ "$requested_generation" -ge 1 ] || die "publish generation must be a positive integer"
	dir=$(sadir "$id"); [ -d "$dir" ] || die "no subagent #$id"
	[ "$source" = "$dir/report.next.md" ] || die "publish source must be $dir/report.next.md"
	[ -f "$source" ] && [ ! -L "$source" ] && [ -s "$source" ] || die "publish report is missing, empty, or not a regular file"
	lock_acquire "$dir/.event.lock" "event consumer for subagent #$id"
	if ! lease=$(node "$STATE_HELPER" lease "$dir/lifecycle.json"); then lock_release; die "lifecycle for subagent #$id is missing or malformed"; fi
	IFS=$'\t' read -r state generation <<<"$lease"
	[ "$generation" = "$requested_generation" ] || { lock_release; die "stale publication for generation $requested_generation; current generation is $generation"; }
	case "$state" in working|awaiting-follow-up|blocked) ;; *) lock_release; die "cannot publish from lifecycle state $state" ;; esac
	line=$(publish_report_locked "$id" "$generation" "$outcome" "$source"); rc=$?
	if [ "$rc" != 0 ] && [ "$rc" != 3 ]; then lock_release; die "failed to publish report for subagent #$id"; fi
	lock_release
	echo "published $outcome report for subagent #$id generation $generation"
}

cmd_tell() {
	local id="${1:-}"; shift || true
	local msg="$*" dir pane generation old_generation old_state lease reminder draft_dir draft
	[ -n "$id" ] && [ -n "$msg" ] || die "usage: subagents tell <id> <message...>"
	dir=$(sadir "$id"); [ -d "$dir" ] || die "no subagent #$id"
	lock_acquire "$dir/.event.lock" "event consumer for subagent #$id"
	pane=$(cat "$dir/pane" 2>/dev/null || true)
	if [ -z "$pane" ] || ! pane_alive "$pane"; then lock_release; die "subagent #$id is not running"; fi
	if ! lease=$(node "$STATE_HELPER" lease "$dir/lifecycle.json"); then lock_release; die "could not read lifecycle for subagent #$id"; fi
	IFS=$'\t' read -r old_state old_generation <<<"$lease"
	if [ -s "$dir/report.next.md" ]; then
		case "$old_state" in
			awaiting-follow-up|blocked) rm -f "$dir/report.next.md" || { lock_release; die "could not reset published report source"; } ;;
			*)
				draft_dir="$dir/unpublished"; mkdir -p "$draft_dir" || { lock_release; die "could not preserve unpublished report draft"; }
				draft="$draft_dir/generation-$old_generation-$(date +%s)-$RANDOM.md"
				mv "$dir/report.next.md" "$draft" || { lock_release; die "could not preserve unpublished report draft"; }
				;;
		esac
	else
		rm -f "$dir/report.next.md" 2>/dev/null || true
	fi
	if ! lifecycle_transition "$id" tell >/dev/null; then lock_release; die "could not cancel cleanup for subagent #$id"; fi
	generation=$(node "$STATE_HELPER" lease "$dir/lifecycle.json" | awk -F '\t' '{print $2}') || { lock_release; die "could not read follow-up generation"; }
	: >"$dir/result.md" || { lock_release; die "could not reset current report for subagent #$id"; }
	write_protocol "$id" "$dir/result.md" "$dir/report.next.md" "$generation" >"$dir/protocol.md" || { lock_release; die "could not update report protocol"; }
	reminder="[pi-subagents generation $generation: use the generation $generation publish command from protocol.md]"
	if ! send_pane "$pane" "$msg $reminder"; then lock_release; die "failed to send follow-up to subagent #$id; lifecycle remains working and cleanup is cancelled"; fi
	lock_release
	echo "sent to subagent #$id (generation $generation; cleanup cancelled)"
}

cmd_retain() {
	local id="${1:-}" dir
	[ -n "$id" ] || die "usage: subagents retain <id>"
	dir=$(sadir "$id"); [ -d "$dir" ] || die "no subagent #$id"
	lock_acquire "$dir/.event.lock" "event consumer for subagent #$id"
	if ! lifecycle_transition "$id" retain >/dev/null; then lock_release; die "could not retain subagent #$id"; fi
	lock_release
	echo "retained subagent #$id; cleanup cancelled"
}

cmd_release() {
	local id="${1:-}" dir
	[ -n "$id" ] || die "usage: subagents release <id>"
	dir=$(sadir "$id"); [ -d "$dir" ] || die "no subagent #$id"
	lock_acquire "$dir/.event.lock" "event consumer for subagent #$id"
	if ! lifecycle_transition "$id" release >/dev/null; then lock_release; die "could not release subagent #$id"; fi
	lock_release
	echo "released subagent #$id; normal cleanup grace applies"
}

cmd_wait() {
	local id="${1:-}" secs="${2:-$DEFAULT_WAIT}" i line status report
	[ -n "$id" ] || die "usage: subagents wait <id> [seconds]"
	case "$secs" in ''|*[!0-9]*) die "wait seconds must be a non-negative integer" ;; esac
	[ -d "$(sadir "$id")" ] || die "no subagent #$id"
	for ((i = 0; i < secs; i += 2)); do
		if line=$(detect_and_emit "$id" 0) && [ -n "$line" ]; then
			IFS=$'\t' read -r _ status report <<<"$line"
			echo "=== subagent #$id report ($status) ==="
			if ! cat "$report"; then return 1; fi
			pull_ack "$id" || die "report printed but acknowledgement failed; it will be delivered again"
			return 0
		fi
		sleep 2
	done
	echo "[subagent #$id has no published report after ${secs}s — it remains working/unknown; use 'subagents peek $id' to inspect]"
	return 1
}

cmd_events() {
	local dir id rc failures=0
	for dir in "$(sr)"/*/; do
		[ -d "$dir" ] || continue
		id=$(basename "$dir"); case "$id" in ''|*[!0-9]*) continue ;; esac
		detect_and_emit "$id" 1; rc=$?
		[ "$rc" = 2 ] && failures=$((failures + 1))
	done
	run_cleanup events || failures=$((failures + CLEANUP_FAILURES))
	[ "$failures" = 0 ]
}

cmd_reap() {
	local dir id line status report rc any=0 failures=0
	for dir in "$(sr)"/*/; do
		[ -d "$dir" ] || continue
		id=$(basename "$dir"); case "$id" in ''|*[!0-9]*) continue ;; esac
		if line=$(detect_and_emit "$id" 0) && [ -n "$line" ]; then
			IFS=$'\t' read -r _ status report <<<"$line"
			echo "=== subagent #$id — $status ==="
			if cat "$report"; then pull_ack "$id" || failures=$((failures + 1)); else failures=$((failures + 1)); fi
			echo
			any=1
		else
			rc=$?; [ "$rc" = 2 ] && failures=$((failures + 1))
		fi
	done
	[ "$any" = 1 ] || echo "no new reports"
	[ "$failures" = 0 ]
}

cmd_status() {
	local dir id pane pane_state json found=0 now
	now=$(date +%s)
	for dir in "$(sr)"/*/; do
		[ -d "$dir" ] || continue
		id=$(basename "$dir"); case "$id" in ''|*[!0-9]*) continue ;; esac
		pane=$(cat "$dir/pane" 2>/dev/null || true)
		if [ -n "$pane" ] && pane_alive "$pane"; then pane_state=alive; else pane_state=dead; fi
		if json=$(node "$STATE_HELPER" status "$dir/lifecycle.json" 2>/dev/null); then
			node - "$id" "$pane_state" "$now" "$CLEANUP_GRACE_SECONDS" "$json" <<'NODE'
const [id, pane, rawNow, rawGrace, raw] = process.argv.slice(2);
const value = JSON.parse(raw);
let cleanup = "protected";
if (value.state === "awaiting-follow-up") {
	if (value.retained) cleanup = "retained";
	else if (value.candidateSince !== null) cleanup = `eligible-in=${Math.max(0, Number(rawGrace) - (Number(rawNow) - value.candidateSince))}s`;
}
console.log(`#${id}\t${value.state}\tpane=${pane}\tretained=${value.retained ? "yes" : "no"}\tgeneration=${value.generation}\tcleanup=${cleanup}`);
NODE
		else
			printf '#%s\tunknown\tpane=%s\tcleanup=protected (missing/malformed lifecycle)\n' "$id" "$pane_state"
		fi
		found=1
	done
	[ "$found" = 1 ] || echo "no subagents"
}

cmd_peek() {
	local id="${1:-}" lines="${2:-40}" dir pane
	[ -n "$id" ] || die "usage: subagents peek <id> [lines]"
	case "$lines" in ''|*[!0-9]*) die "peek lines must be a non-negative integer" ;; esac
	dir=$(sadir "$id"); [ -d "$dir" ] || die "no subagent #$id"
	pane=$(cat "$dir/pane" 2>/dev/null || true)
	[ -n "$pane" ] && pane_alive "$pane" || { echo "[subagent #$id not running]"; return 0; }
	tmux capture-pane -p -t "$pane" | grep -v '^[[:space:]]*$' | tail -"$lines"
}

cmd_ls() { cmd_status; }

stop_one() {
	local id="$1" dir pane rc=0 emit_rc
	dir=$(sadir "$id"); [ -d "$dir" ] || { echo "subagents: no subagent #$id" >&2; return 1; }
	lock_acquire "$dir/.event.lock" "event consumer for subagent #$id"
	_emit_for_locked "$id" 1 >/dev/null; emit_rc=$?
	[ "$emit_rc" = 2 ] && echo "subagents: warning: could not publish current state for subagent #$id; report files are preserved" >&2
	pane=$(cat "$dir/pane" 2>/dev/null || true)
	if [ -n "$pane" ] && pane_alive "$pane"; then
		if ! tmux kill-pane -t "$pane" 2>/dev/null; then echo "subagents: failed to stop pane for subagent #$id" >&2; rc=1; fi
	fi
	if node "$STATE_HELPER" validate "$dir/lifecycle.json" 2>/dev/null; then
		lifecycle_transition "$id" stopped >/dev/null || { echo "subagents: failed to persist stopped lifecycle for subagent #$id" >&2; rc=1; }
	else
		echo "subagents: lifecycle for subagent #$id is malformed; pane was manually stopped and all state was preserved" >&2
		rc=1
	fi
	lock_release
	if [ "$rc" = 0 ]; then echo "stopped subagent #$id; reports and delivery state preserved (use purge after acknowledgement)"; fi
	return "$rc"
}

cmd_stop() {
	local target="${1:-}" dir id failures=0
	[ -n "$target" ] || die "usage: subagents stop <id|--all>"
	if [ "$target" = --all ]; then
		for dir in "$(sr)"/*/; do
			[ -d "$dir" ] || continue
			id=$(basename "$dir"); case "$id" in ''|*[!0-9]*) continue ;; esac
			stop_one "$id" || failures=$((failures + 1))
		done
		[ "$failures" = 0 ]
	else
		stop_one "$target"
	fi
}

cmd_cleanup() {
	if [ "$CLEANUP_MODE" = off ]; then echo "cleanup: disabled (SUBAGENTS_CLEANUP_MODE=off)"; return 0; fi
	run_cleanup manual || true
	[ "$CLEANUP_ACTIONS" -gt 0 ] || echo "cleanup: no eligible completed workers"
	[ "$CLEANUP_FAILURES" = 0 ]
}

ack_cli() {
	local id="${1:-}" event_id="${2:-}" pending_name="${3:-}" dir pending_path
	[ -n "$id" ] && [ -n "$event_id" ] && [ -n "$pending_name" ] || die "invalid watcher acknowledgement"
	case "$pending_name" in *[!A-Za-z0-9._-]*|''|.|..) die "invalid pending event name" ;; esac
	dir=$(sadir "$id"); [ -d "$dir" ] || die "no subagent #$id"
	pending_path="$(sr)/.watcher-pending/$pending_name"
	lock_acquire "$dir/.event.lock" "event consumer for subagent #$id"
	if ! ack_event_locked "$id" "$event_id" "$pending_path"; then lock_release; die "failed to acknowledge event $event_id for subagent #$id"; fi
	lock_release
}

purge_one() {
	local id="$1" dir pane event_ids event_id
	dir=$(sadir "$id"); [ -d "$dir" ] || { echo "subagents: no subagent #$id" >&2; return 1; }
	lock_acquire "$dir/.event.lock" "event consumer for subagent #$id"
	pane=$(cat "$dir/pane" 2>/dev/null || true)
	if [ -n "$pane" ] && pane_alive "$pane"; then lock_release; echo "subagents: subagent #$id is still running; stop it before purge" >&2; return 1; fi
	if ! event_ids=$(node "$STATE_HELPER" purge-check "$dir" "$(sr)"); then lock_release; return 1; fi
	# The lifecycle is terminal and no pending event exists. Remove the directory
	# while still owning its event lock so no stop/tell/ack operation can interleave.
	if ! rm -rf "$dir"; then lock_release; echo "subagents: failed to purge state for subagent #$id" >&2; return 1; fi
	LOCK_PATH=""; LOCK_TOKEN=""; LOCK_CANDIDATE=""; LOCK_SNAPSHOT=""
	for event_id in $event_ids; do rm -f "$(sr)/.watcher-delivered/$event_id" 2>/dev/null || true; done
	echo "purged subagent #$id after report acknowledgement"
}

cmd_purge() {
	local target="${1:-}" dir id failures=0
	[ -n "$target" ] || die "usage: subagents purge <id|--all>"
	if [ "$target" = --all ]; then
		for dir in "$(sr)"/*/; do
			[ -d "$dir" ] || continue
			id=$(basename "$dir"); case "$id" in ''|*[!0-9]*) continue ;; esac
			purge_one "$id" || failures=$((failures + 1))
		done
		[ "$failures" = 0 ]
	else
		purge_one "$target"
	fi
}

usage() { awk 'NR>1 && /^#/{sub(/^# ?/,""); print; next} NR>1 && !/^#/{exit}' "$0"; }

cmd="${1:-}"; shift || true
case "$cmd" in
	protocol) cmd_protocol "$@" ;;
	config) cmd_config "$@" ;;
	""|-h|--help|help) usage ;;
	doctor|run|publish|tell|retain|release|wait|events|reap|status|peek|ls|cleanup|stop|purge|ack)
		prepare_session_state
		case "$cmd" in
			doctor) cmd_doctor "$@" ;;
			run) cmd_run "$@" ;;
			publish) cmd_publish "$@" ;;
			tell) cmd_tell "$@" ;;
			retain) cmd_retain "$@" ;;
			release) cmd_release "$@" ;;
			wait) cmd_wait "$@" ;;
			events) cmd_events "$@" ;;
			reap) cmd_reap "$@" ;;
			status) cmd_status "$@" ;;
			peek) cmd_peek "$@" ;;
			ls) cmd_ls "$@" ;;
			cleanup) cmd_cleanup "$@" ;;
			stop) cmd_stop "$@" ;;
			purge) cmd_purge "$@" ;;
			ack) ack_cli "$@" ;;
		esac
		;;
	*) die "unknown command '$cmd' (try: subagents --help)" ;;
esac
