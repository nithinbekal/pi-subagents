#!/usr/bin/env bash
#
# subagents — run isolated Pi workers in tmux and durably deliver their reports.
#
# Usage:
#   subagents protocol                  Print the package/CLI/watcher protocol identity as JSON.
#   subagents config                    Print resolved launcher, state, cleanup, and protocol configuration.
#   subagents doctor                    Validate the launcher, tmux, schema, locks, and worker state.
#   subagents run [-m MODEL] [--effort LEVEL] <task...>
#                                       Start a worker with a complete task brief. Without -m,
#                                       inherit PI_PROVIDER/PI_MODEL and PI_REASONING_LEVEL from
#                                       the lead shell environment when they are available.
#   subagents tell <id> <message...>    Cancel cleanup and send a generation-scoped follow-up.
#   subagents retain <id>               Retain a worker until explicitly released.
#   subagents release <id>              Release a retained worker to the normal cleanup grace.
#   subagents wait <id> [seconds]       Block until a durable completion is available; print and ack it.
#   subagents publish ...               Internal generation-scoped report publication command.
#   subagents events                    Queue exit diagnostics and apply cleanup (watcher protocol).
#   subagents reap                      Print and acknowledge all pending reports for pull mode.
#   subagents status                    Show lifecycle, pane, retention, and cleanup state without task text.
#   subagents peek <id> [lines]         Show the tail of a worker pane.
#   subagents ls                        List workers without task text.
#   subagents cleanup                   Apply the configured completed-worker cleanup policy now.
#   subagents stop <id|--all>           Stop panes while preserving reports and delivery state.
#   subagents purge <id|--all>          Delete stopped state only after every report is acknowledged.

set -uo pipefail

PI_CMD="${SUBAGENTS_PI:-pi}"
STATE_DIR="${SUBAGENTS_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/subagents}"
WIN_PREFIX="${SUBAGENTS_WINDOW_NAME:-subagents}"
SENTINEL="@@DONE@@"
DEFAULT_WAIT=120
PACKAGE_VERSION="0.3.1"
PROTOCOL_ID="pi-subagents"
CLI_API_VERSION=1
WATCHER_API_VERSION=1
STATE_SCHEMA_VERSION=1
EVENT_SCHEMA_VERSION=1
LIFECYCLE_SCHEMA_VERSION=1
DEFAULT_CLEANUP_GRACE_SECONDS=600
CLEANUP_MODE="${SUBAGENTS_CLEANUP_MODE:-on}"
CLEANUP_GRACE_SECONDS="${SUBAGENTS_CLEANUP_GRACE_SECONDS:-$DEFAULT_CLEANUP_GRACE_SECONDS}"
SCRIPT_DIR=$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd)
PACKAGE_ROOT=$(cd "$SCRIPT_DIR/../.." && pwd)
PACKAGE_JSON="$PACKAGE_ROOT/package.json"
PROTOCOL_JSON="$PACKAGE_ROOT/protocol.json"
STATE_HELPER="$SCRIPT_DIR/state.mjs"
CLI_PATH="$SCRIPT_DIR/subagents"

# These globals carry lock and snapshot ownership only within one CLI process.
LOCK_PATH=""
LOCK_TOKEN=""
LOCK_CANDIDATE=""
LOCK_SNAPSHOT=""
SNAPSHOT_PATH=""
SNAPSHOT_NUMBER=""
_CURRENT_SESSION=""
_SR=""
CLEANUP_ACTIONS=0
CLEANUP_FAILURES=0

# Print an error and let the EXIT trap release any lock held by this process.
die() { echo "subagents: $*" >&2; exit 1; }
in_tmux() { [ -n "${TMUX:-}" ]; }

validate_package_contract() {
	command -v node >/dev/null 2>&1 || die "node is required"
	[ -f "$PACKAGE_JSON" ] || die "package is incomplete: missing $PACKAGE_JSON"
	[ -f "$PROTOCOL_JSON" ] || die "package is incomplete: missing $PROTOCOL_JSON"
	[ -f "$STATE_HELPER" ] || die "package is incomplete: missing $STATE_HELPER"
	local helper_protocol
	helper_protocol=$(node "$STATE_HELPER" protocol) || die "state helper protocol check failed"
	if ! node - "$PACKAGE_JSON" "$PROTOCOL_JSON" "$helper_protocol" "$PROTOCOL_ID" "$PACKAGE_VERSION" \
		"$CLI_API_VERSION" "$WATCHER_API_VERSION" "$STATE_SCHEMA_VERSION" "$EVENT_SCHEMA_VERSION" "$LIFECYCLE_SCHEMA_VERSION" <<'NODE'
const fs = require("node:fs");
const [packagePath, protocolPath, helperText, protocolId, packageVersion, cliApi, watcherApi, stateSchema, eventSchema, lifecycleSchema] = process.argv.slice(2);
try {
	const manifest = JSON.parse(fs.readFileSync(packagePath, "utf8"));
	const protocol = JSON.parse(fs.readFileSync(protocolPath, "utf8"));
	const helper = JSON.parse(helperText);
	const expected = {
		protocolId,
		packageVersion,
		cliApiVersion: Number(cliApi),
		watcherApiVersion: Number(watcherApi),
		stateSchemaVersion: Number(stateSchema),
		eventSchemaVersion: Number(eventSchema),
		lifecycleSchemaVersion: Number(lifecycleSchema),
	};
	if (manifest.version !== packageVersion) throw new Error(`package version ${manifest.version} does not match CLI ${packageVersion}`);
	if (JSON.stringify(protocol) !== JSON.stringify(expected)) throw new Error(`package protocol mismatch: found ${JSON.stringify(protocol)}, expected ${JSON.stringify(expected)}`);
	if (JSON.stringify(helper) !== JSON.stringify(expected)) throw new Error(`state helper protocol mismatch: found ${JSON.stringify(helper)}, expected ${JSON.stringify(expected)}`);
} catch (error) {
	console.error(`subagents: ${error.message}`);
	process.exit(1);
}
NODE
	then
		exit 1
	fi
}

validate_cleanup_config() {
	case "$CLEANUP_MODE" in on|off|dry-run|notify) ;; *) die "invalid SUBAGENTS_CLEANUP_MODE '$CLEANUP_MODE' (expected on, off, dry-run, or notify)" ;; esac
	case "$CLEANUP_GRACE_SECONDS" in ''|*[!0-9]*) die "invalid SUBAGENTS_CLEANUP_GRACE_SECONDS '$CLEANUP_GRACE_SECONDS'" ;; esac
}

validate_package_contract
validate_cleanup_config

# ---- tmux and session-scoped state ---------------------------------------

current_session_id() {
	[ -n "$_CURRENT_SESSION" ] && { printf '%s' "$_CURRENT_SESSION"; return 0; }
	if [ -n "${TMUX_PANE:-}" ]; then
		_CURRENT_SESSION=$(tmux display-message -pt "$TMUX_PANE" '#{session_id}' 2>/dev/null || true)
	fi
	if [ -z "$_CURRENT_SESSION" ] && [ -n "${TMUX:-}" ]; then
		local num
		num=$(printf '%s' "$TMUX" | awk -F, '{print $3}')
		case "$num" in ''|*[!0-9]*) ;; *) _CURRENT_SESSION=\$"$num" ;; esac
	fi
	[ -n "$_CURRENT_SESSION" ] || _CURRENT_SESSION=$(tmux display-message -p '#{session_id}' 2>/dev/null || true)
	printf '%s' "$_CURRENT_SESSION"
}

valid_session_id() {
	local number
	case "$1" in \$*) number=${1#\$} ;; *) return 1 ;; esac
	case "$number" in ''|*[!0-9]*) return 1 ;; *) return 0 ;; esac
}

sr() {
	[ -n "$_SR" ] && { printf '%s' "$_SR"; return 0; }
	local session_id
	session_id=$(current_session_id)
	[ -n "$session_id" ] || die "cannot determine current tmux session"
	_SR="$STATE_DIR/$session_id"
	mkdir -p "$_SR" || die "could not create session state at $_SR"
	printf '%s' "$_SR"
}

sadir() {
	local id="$1"
	case "$id" in ''|*[!0-9]*) die "invalid subagent id '${id:-<empty>}'" ;; esac
	printf '%s/%s' "$(sr)" "$id"
}

lifecycle_file() { printf '%s/lifecycle.json' "$(sadir "$1")"; }

subagents_windows() {
	tmux list-windows -t "$1" -F '#{window_id} #{window_name}' 2>/dev/null \
		| awk -v p="$WIN_PREFIX" '$2==p || index($2, p" (")==1 {print $1}'
}

subagents_window() { subagents_windows "$1" | head -1; }

pane_alive() {
	tmux list-panes -a -F '#{pane_id} #{pane_dead}' 2>/dev/null \
		| awk -v p="$1" '$1==p{print $2}' | grep -qx 0
}

send_pane() {
	local pane="$1"; shift
	local msg="$*"
	msg=${msg//$'\n'/ }
	tmux send-keys -t "$pane" -l -- "$msg" || return 1
	sleep 0.3
	tmux send-keys -t "$pane" Enter || return 1
}

# ---- one hard-link lock protocol for every critical section --------------

process_identity() {
	local identity
	identity=$(ps -o lstart= -p "$1" 2>/dev/null | cksum 2>/dev/null | awk '{print $1 ":" $2}')
	[ -n "$identity" ] && printf '%s\n' "$identity" || printf '%s\n' unknown
}

lock_record_valid() {
	local owner_pid="" owner_identity="" owner_token="" owner_time="" extra=""
	read -r owner_pid owner_identity owner_token owner_time extra <"$1" 2>/dev/null || return 1
	case "$owner_pid" in ''|*[!0-9]*) return 1 ;; esac
	case "$owner_time" in ''|*[!0-9]*) return 1 ;; esac
	[ -n "$owner_identity" ] && [ -n "$owner_token" ] && [ -z "$extra" ]
}

lock_snapshot() {
	local lock="$1"
	LOCK_SNAPSHOT="${lock}.inspect.${BASHPID:-$$}.$RANDOM"
	if ! ln "$lock" "$LOCK_SNAPSHOT" 2>/dev/null; then
		LOCK_SNAPSHOT=""
		return 1
	fi
}

lock_snapshot_remove() {
	[ -z "$LOCK_SNAPSHOT" ] || rm -f "$LOCK_SNAPSHOT" 2>/dev/null || true
	LOCK_SNAPSHOT=""
}

# Every read is guarded and every local is initialized. A normal owner may
# unlink the published path between any two checks; that is contention, not a
# malformed record and never an excuse to evaluate an unset owner_pid.
lock_owner_abandoned() {
	local lock="$1" owner_pid="" owner_identity="" owner_token="" owner_time="" extra="" current_identity
	read -r owner_pid owner_identity owner_token owner_time extra <"$lock" 2>/dev/null || return 1
	case "$owner_pid" in ''|*[!0-9]*) return 1 ;; esac
	case "$owner_time" in ''|*[!0-9]*) return 1 ;; esac
	[ -n "$owner_identity" ] && [ -n "$owner_token" ] && [ -z "$extra" ] || return 1
	if ! kill -0 "$owner_pid" 2>/dev/null; then return 0; fi
	if [ "$owner_identity" != unknown ]; then
		current_identity=$(process_identity "$owner_pid")
		[ "$current_identity" != unknown ] && [ "$current_identity" != "$owner_identity" ] && return 0
	fi
	return 1
}

lock_owner_description() {
	local owner_pid="" owner_identity="" owner_token="" owner_time=""
	if ! read -r owner_pid owner_identity owner_token owner_time <"$1" 2>/dev/null; then
		printf '%s' "unreadable owner"
		return
	fi
	printf 'pid %s, acquired %s' "$owner_pid" "$owner_time"
}

recover_abandoned_lock() {
	local lock="$1" label="$2" recovery="${1}.recover" owner
	lock_owner_abandoned "$lock" || return 1
	if [ -e "$recovery" ] && ! { [ -f "$lock" ] && [ "$lock" -ef "$recovery" ]; }; then return 1; fi
	[ ! -e "$recovery" ] || return 1
	ln "$lock" "$recovery" 2>/dev/null || return 1
	if [ ! -f "$lock" ] || [ ! "$lock" -ef "$recovery" ] || ! lock_owner_abandoned "$recovery"; then
		rm -f "$recovery" 2>/dev/null || true
		return 1
	fi
	owner=$(lock_owner_description "$recovery")
	rm -f "$lock" || { rm -f "$recovery" 2>/dev/null || true; return 1; }
	rm -f "$recovery" 2>/dev/null || true
	echo "subagents: recovered abandoned $label lock ($owner)" >&2
	return 0
}

lock_release() {
	local owner_pid="" owner_identity="" owner_token="" owner_time=""
	[ -n "$LOCK_PATH" ] || return 0
	if lock_snapshot "$LOCK_PATH"; then
		if read -r owner_pid owner_identity owner_token owner_time <"$LOCK_SNAPSHOT" 2>/dev/null \
			&& [ "$owner_token" = "$LOCK_TOKEN" ] \
			&& [ -f "$LOCK_PATH" ] && [ "$LOCK_PATH" -ef "$LOCK_SNAPSHOT" ]; then
			rm -f "$LOCK_PATH" 2>/dev/null || true
		fi
		lock_snapshot_remove
	fi
	LOCK_PATH=""
	LOCK_TOKEN=""
}

lock_cleanup() {
	lock_snapshot_remove
	[ -z "$LOCK_CANDIDATE" ] || rm -f "$LOCK_CANDIDATE" 2>/dev/null || true
	LOCK_CANDIDATE=""
	lock_release
}

lock_acquire() {
	local lock="$1" label="$2" attempts=0 owner_pid owner_identity
	[ -z "$LOCK_PATH" ] || die "internal error: nested CLI lock"
	[ ! -d "$lock" ] || die "unsupported lock directory at $lock; remove it after confirming no CLI is running"
	owner_pid=${BASHPID:-$$}
	owner_identity=$(process_identity "$owner_pid")
	LOCK_TOKEN="$owner_pid.$(date +%s).$RANDOM"
	LOCK_CANDIDATE="${lock}.candidate.$LOCK_TOKEN"
	printf '%s %s %s %s\n' "$owner_pid" "$owner_identity" "$LOCK_TOKEN" "$(date +%s)" >"$LOCK_CANDIDATE" \
		|| die "could not create $label lock candidate"
	trap 'lock_cleanup' EXIT
	trap 'lock_cleanup; exit 1' HUP INT TERM

	while :; do
		if ln "$LOCK_CANDIDATE" "$lock" 2>/dev/null; then
			LOCK_PATH="$lock"
			rm -f "$LOCK_CANDIDATE" 2>/dev/null || true
			LOCK_CANDIDATE=""
			return 0
		fi
		[ ! -d "$lock" ] || die "unsupported lock directory at $lock; remove it after confirming no CLI is running"
		if lock_snapshot "$lock"; then
			if ! lock_record_valid "$LOCK_SNAPSHOT"; then
				if [ -f "$lock" ] && [ "$lock" -ef "$LOCK_SNAPSHOT" ]; then
					lock_snapshot_remove
					die "invalid $label lock record at $lock; refusing unsafe recovery"
				fi
				lock_snapshot_remove
				continue
			fi
			lock_snapshot_remove
		fi
		recover_abandoned_lock "$lock" "$label" && continue
		attempts=$((attempts + 1))
		if [ "$attempts" -ge 400 ]; then
			if lock_owner_abandoned "$lock"; then die "timed out recovering abandoned $label lock at $lock"; fi
			die "timed out waiting for $label lock at $lock"
		fi
		sleep 0.025
	done
}

# ---- schema identity ------------------------------------------------------

ensure_state_contract() {
	local root="$1" marker="$1/.schema.json" lock="$1/.schema.lock"
	mkdir -p "$root" || die "could not create session state at $root"
	lock_acquire "$lock" "state schema"
	if ! node - "$marker" "$PROTOCOL_JSON" <<'NODE'
const fs = require("node:fs");
const path = require("node:path");
const { randomUUID } = require("node:crypto");
const [marker, protocolPath] = process.argv.slice(2);
const expected = JSON.parse(fs.readFileSync(protocolPath, "utf8"));
const directory = path.dirname(marker);
if (fs.existsSync(marker)) {
	let actual;
	try { actual = JSON.parse(fs.readFileSync(marker, "utf8")); } catch (error) {
		console.error(`state contract at ${marker} is unreadable: ${error.message}`);
		process.exit(1);
	}
	if (JSON.stringify(actual) !== JSON.stringify(expected)) {
		console.error(`state schema/version mismatch at ${marker}: found ${JSON.stringify(actual)}, expected ${JSON.stringify(expected)}`);
		process.exit(1);
	}
	process.exit(0);
}
const residue = fs.readdirSync(directory).filter((name) => !name.startsWith(".schema.lock"));
if (residue.length > 0) {
	console.error(`unversioned state at ${directory} is not supported (found ${residue.join(", ")})`);
	process.exit(1);
}
const temporary = path.join(directory, `.${path.basename(marker)}.${randomUUID()}.tmp`);
let descriptor;
try {
	descriptor = fs.openSync(temporary, "wx", 0o600);
	fs.writeFileSync(descriptor, `${JSON.stringify(expected)}\n`, "utf8");
	fs.fsyncSync(descriptor);
	fs.closeSync(descriptor);
	descriptor = undefined;
	fs.renameSync(temporary, marker);
	const dirfd = fs.openSync(directory, "r");
	try { fs.fsyncSync(dirfd); } finally { fs.closeSync(dirfd); }
} catch (error) {
	if (descriptor !== undefined) try { fs.closeSync(descriptor); } catch {}
	try { fs.unlinkSync(temporary); } catch {}
	console.error(`could not persist state contract at ${marker}: ${error.message}`);
	process.exit(1);
}
NODE
	then
		lock_release
		die "incompatible session state; mixed or legacy package state is not supported"
	fi
	lock_release
}

prepare_session_state() {
	in_tmux || die "subagents requires tmux"
	ensure_state_contract "$(sr)"
}

lifecycle_transition() {
	local id="$1" operation="$2"; shift 2
	node "$STATE_HELPER" transition "$(lifecycle_file "$id")" "$operation" "$(date +%s)" "$@"
}

# ---- worker creation and publication protocol ----------------------------

reserve_id() {
	local root lock seq candidate tmp
	root=$(sr)
	lock="$root/.seq.lock"
	lock_acquire "$lock" "sequence"
	seq=$(cat "$root/.seq" 2>/dev/null || echo 0)
	case "$seq" in ''|*[!0-9]*) die "invalid subagent id counter at $root/.seq" ;; esac
	candidate=$((seq + 1))
	[ ! -e "$root/$candidate" ] || die "subagent id counter conflicts with existing agent #$candidate"
	tmp="$root/.seq.tmp.$$.$RANDOM"
	printf '%s\n' "$candidate" >"$tmp" || die "could not persist subagent id counter"
	mv "$tmp" "$root/.seq" || die "could not persist subagent id counter"
	mkdir "$root/$candidate" || die "could not create state for subagent #$candidate"
	if ! node "$STATE_HELPER" init "$root/$candidate/lifecycle.json" "$candidate" "$(date +%s)"; then
		rm -rf "$root/$candidate"
		die "could not initialize lifecycle for subagent #$candidate"
	fi
	lock_release
	printf '%s\n' "$candidate"
}

create_subagent_pane() {
	local session="$1" picmd="$2" lock win pane
	lock="$(sr)/.window.lock"
	lock_acquire "$lock" "tmux window"
	win=$(subagents_window "$session")
	if [ -z "$win" ]; then
		if ! pane=$(tmux new-window -d -t "$session" -n "$WIN_PREFIX" -P -F '#{pane_id}' "$picmd"); then
			lock_release
			return 1
		fi
	else
		if ! pane=$(tmux split-window -d -t "$win" -P -F '#{pane_id}' "$picmd"); then
			lock_release
			return 1
		fi
		tmux select-layout -t "$win" tiled >/dev/null 2>&1 || true
	fi
	lock_release
	printf '%s\n' "$pane"
}

write_protocol() {
	local id="$1" result="$2" temporary="$3" generation="$4" q_state q_cli q_id q_temp q_generation
	q_state=$(printf %q "$STATE_DIR"); q_cli=$(printf %q "$CLI_PATH"); q_id=$(printf %q "$id")
	q_temp=$(printf %q "$temporary"); q_generation=$(printf %q "$generation")
	cat <<EOF
# Subagent protocol (important)

You are an autonomous helper in a tmux pane. The launch task is your complete
brief. Work autonomously and use later lead messages as follow-up instructions.
The lead cannot see your pane; it receives only durably published reports.

For generation $generation, finish every completed or blocked task this way:

1. Write the complete report to this file, overwriting it for this generation:
   $temporary
2. Publish exactly one explicit outcome with one of these commands:
   SUBAGENTS_STATE_DIR=$q_state $q_cli publish $q_id completed $q_temp $q_generation
   SUBAGENTS_STATE_DIR=$q_state $q_cli publish $q_id blocked $q_temp $q_generation
3. Only after the publish command succeeds, print a line containing exactly:
   $SENTINEL
4. Stop and wait for a follow-up. Repeat with the generation supplied in that
   follow-up; never publish an earlier generation.

The CLI copies the report to the immutable path recorded in the event, fsyncs
the completion spool, and only then commits lifecycle completion. It also keeps
the latest published report at $result. Do not publish completed when you still
need input. Never answer only in chat. Missing/malformed lifecycle or a report
that was written but not published is deliberately treated as still working.

Keep routine reports to 25 lines or fewer. Start with Done or Blocked, then list
what changed, checks run with results, and artifact paths. Include more lines
only when commands, test output, errors, diffs, or links are needed as evidence.
EOF
}

provider_model() {
	local model="$1" provider model_id
	provider=${model%%/*}; model_id=${model#*/}
	[ "$provider" != "$model" ] && [ -n "$provider" ] && [ -n "$model_id" ]
}

valid_effort() {
	case "$1" in off|minimal|low|medium|high|xhigh|max) return 0 ;; *) return 1 ;; esac
}

launcher_binary() {
	local -a launcher_parts=()
	read -r -a launcher_parts <<<"$PI_CMD"
	printf '%s' "${launcher_parts[0]:-}"
}

run_doctor_preflight() {
	local launcher_bin session_id
	# Package and protocol identity are validated before command dispatch.
	launcher_bin=$(launcher_binary)
	[ -n "$launcher_bin" ] && command -v "$launcher_bin" >/dev/null 2>&1 \
		|| die "doctor preflight failed: launcher command not found: ${launcher_bin:-<empty>}"
	command -v tmux >/dev/null 2>&1 || die "doctor preflight failed: tmux command not found"
	in_tmux || die "doctor preflight failed: subagents requires tmux"
	session_id=$(current_session_id)
	valid_session_id "$session_id" || die "doctor preflight failed: unexpected tmux session id '$session_id'"
}

validate_model_id() {
	local requested="$1" suggestions rc
	suggestions=$(node - "$PI_CMD" "$requested" <<'NODE'
const { spawnSync } = require("node:child_process");
const [launcher, requested] = process.argv.slice(2);
const parts = launcher.trim().split(/\s+/).filter(Boolean);
if (parts.length === 0) process.exit(2);
const result = spawnSync(parts[0], [...parts.slice(1), "--list-models"], {
	encoding: "utf8",
	timeout: 850,
	maxBuffer: 5 * 1024 * 1024,
	env: process.env,
});
if (result.error || result.status !== 0 || !result.stdout) process.exit(2);
const models = result.stdout.split("\n").flatMap((line) => {
	const columns = line.trim().split(/\s+/);
	if (columns.length < 2 || columns[0] === "provider") return [];
	return [`${columns[0]}/${columns[1]}`];
});
if (models.length === 0) process.exit(2);
if (models.includes(requested)) process.exit(0);

const uniqueModels = new Map();
for (const entry of models) {
	const separator = entry.indexOf("/");
	const provider = entry.slice(0, separator);
	const model = entry.slice(separator + 1);
	const previous = uniqueModels.get(model);
	if (!previous || provider.length < previous.slice(0, previous.indexOf("/")).length) uniqueModels.set(model, entry);
}
const tokenize = (value) => value.toLowerCase().match(/[a-z0-9]+/g) ?? [];
const requestedProvider = requested.slice(0, requested.indexOf("/"));
const requestedModel = requested.slice(requested.indexOf("/") + 1);
const requestedTokens = tokenize(requestedModel);
const lastToken = requestedTokens.at(-1);
const candidates = [...uniqueModels.values()];
const frequencies = new Map();
for (const candidate of candidates) {
	const tokens = new Set(tokenize(candidate.slice(candidate.indexOf("/") + 1)));
	for (const token of tokens) frequencies.set(token, (frequencies.get(token) ?? 0) + 1);
}
function distance(left, right) {
	let previous = Array.from({ length: right.length + 1 }, (_, index) => index);
	for (let i = 1; i <= left.length; i += 1) {
		const current = [i];
		for (let j = 1; j <= right.length; j += 1) {
			current[j] = Math.min(current[j - 1] + 1, previous[j] + 1, previous[j - 1] + (left[i - 1] === right[j - 1] ? 0 : 1));
		}
		previous = current;
	}
	return previous[right.length];
}
const ranked = candidates.map((candidate) => {
	const separator = candidate.indexOf("/");
	const provider = candidate.slice(0, separator);
	const model = candidate.slice(separator + 1);
	const tokens = new Set(tokenize(model));
	let score = provider === requestedProvider ? 5 : 0;
	for (const token of new Set(requestedTokens)) {
		if (tokens.has(token)) score += Math.log((candidates.length + 1) / ((frequencies.get(token) ?? 0) + 1)) * 10;
	}
	if (lastToken && tokens.has(lastToken)) score += 100;
	score -= (distance(requestedModel, model) / Math.max(requestedModel.length, model.length, 1)) * 10;
	return { candidate, score };
}).sort((left, right) => right.score - left.score || left.candidate.localeCompare(right.candidate));
process.stdout.write(ranked.slice(0, 3).map(({ candidate }) => candidate).join(", "));
process.exit(3);
NODE
); rc=$?
	case "$rc" in
		0) return 0 ;;
		2)
			echo "subagents: warning: Pi model catalog unavailable within 850ms; skipping validation for '$requested'" >&2
			return 0
			;;
		3) die "model '$requested' was not found in Pi's model catalog. Closest matches: ${suggestions:-none}" ;;
		*)
			echo "subagents: warning: Pi model catalog validation failed; skipping validation for '$requested'" >&2
			return 0
			;;
	esac
}

# ---- immutable snapshots and durable completion spool --------------------

snapshot() {
	local id="$1" src="$2" dir n out
	dir=$(sadir "$id")
	n=$(cat "$dir/revent" 2>/dev/null || echo 0)
	case "$n" in ''|*[!0-9]*) n=0 ;; esac
	mkdir -p "$dir/reports" || return 1
	while :; do
		n=$((n + 1))
		out="$dir/reports/$n.md"
		[ -e "$out" ] || break
	done
	node "$STATE_HELPER" snapshot "$src" "$out" || return 1
	SNAPSHOT_PATH="$out"
	SNAPSHOT_NUMBER="$n"
}

commit_snapshot_sequence() {
	local dir="$1" tmp="$1/.revent.tmp.$$.$RANDOM"
	printf '%s\n' "$SNAPSHOT_NUMBER" >"$tmp" && mv "$tmp" "$dir/revent"
}

sync_snapshot_sequence() {
	local dir="$1" report name max=0
	for report in "$dir"/reports/[0-9]*.md; do
		[ -f "$report" ] || continue
		name=$(basename "$report" .md)
		case "$name" in ''|*[!0-9]*) continue ;; esac
		[ "$name" -gt "$max" ] && max="$name"
	done
	[ "$max" -eq 0 ] || printf '%s\n' "$max" >"$dir/revent"
}

publish_report_locked() {
	local id="$1" generation="$2" outcome="$3" source="$4" dir checksum bytes status completion_key event_id spool_name pending target report_arg report_path now existed=0
	dir=$(sadir "$id")
	read -r checksum bytes <<<"$(cksum <"$source")"
	case "$outcome" in completed) status="done" ;; blocked) status="blocked" ;; *) return 2 ;; esac
	completion_key="$id:$status:$generation:$checksum:$bytes"
	event_id=$(node "$STATE_HELPER" event-id "$id" "$generation" "$status" "$completion_key") || return 2
	spool_name="$id-$generation-$event_id"
	pending="$(sr)/.watcher-pending"
	target="$pending/$spool_name.json"
	mkdir -p "$pending" || return 2
	if [ -f "$target" ]; then
		existed=1
		report_arg=""
	else
		if ! snapshot "$id" "$source"; then
			echo "subagents: could not snapshot completion for subagent #$id" >&2
			return 2
		fi
		report_arg="$SNAPSHOT_PATH"
	fi
	now=$(date +%s)
	if ! report_path=$(node "$STATE_HELPER" spool "$target" "$(sr)" "$id" "$generation" "$status" "$outcome" \
		"$completion_key" "$event_id" "$report_arg" "$now"); then
		echo "subagents: could not durably queue completion for subagent #$id" >&2
		return 2
	fi
	if ! node "$STATE_HELPER" finish-publish "$dir/lifecycle.json" "$outcome" "$now" "$generation" \
		"$completion_key" "$spool_name" "$event_id" "$report_path"; then
		echo "subagents: could not commit lifecycle completion for subagent #$id" >&2
		return 2
	fi
	if ! node "$STATE_HELPER" replace-snapshot "$report_path" "$dir/result.md"; then
		echo "subagents: completion is durable, but could not update current report for subagent #$id" >&2
		return 2
	fi
	if [ "$existed" = 1 ]; then
		sync_snapshot_sequence "$dir"
		return 3
	fi
	commit_snapshot_sequence "$dir" || return 2
	printf '%s\t%s\t%s\n' "$id" "$status" "$report_path"
	return 0
}

publish_exit_locked() {
	local id="$1" generation="$2" dir pane source checksum bytes status="exited" outcome="exited" completion_key event_id spool_name pending target report_arg report_path now existed=0
	dir=$(sadir "$id")
	pane=$(cat "$dir/pane" 2>/dev/null || true)
	source="$dir/.exit-report.tmp.$$.$RANDOM"
	{ tmux capture-pane -p -S - -t "$pane" 2>/dev/null | grep -v '^[[:space:]]*$' | tail -40 || true; } >"$source"
	[ -s "$source" ] || printf 'subagent #%s exited without a published report\n' "$id" >"$source"
	read -r checksum bytes <<<"$(cksum <"$source")"
	completion_key="$id:$status:$generation:$checksum:$bytes"
	event_id=$(node "$STATE_HELPER" event-id "$id" "$generation" "$status" "$completion_key") || { rm -f "$source"; return 2; }
	spool_name="$id-$generation-$event_id"
	pending="$(sr)/.watcher-pending"
	target="$pending/$spool_name.json"
	mkdir -p "$pending" || { rm -f "$source"; return 2; }
	if [ -f "$target" ]; then
		existed=1
		report_arg=""
	else
		if ! snapshot "$id" "$source"; then rm -f "$source"; return 2; fi
		report_arg="$SNAPSHOT_PATH"
	fi
	rm -f "$source"
	now=$(date +%s)
	report_path=$(node "$STATE_HELPER" spool "$target" "$(sr)" "$id" "$generation" "$status" "$outcome" \
		"$completion_key" "$event_id" "$report_arg" "$now") || return 2
	node "$STATE_HELPER" finish-exit "$dir/lifecycle.json" "$now" "$generation" "$completion_key" \
		"$spool_name" "$event_id" "$report_path" || return 2
	if [ "$existed" = 1 ]; then sync_snapshot_sequence "$dir"; return 3; fi
	commit_snapshot_sequence "$dir" || return 2
	printf '%s\t%s\t%s\n' "$id" "$status" "$report_path"
}

_emit_for_locked() {
	local id="$1" durable="${2:-1}" dir lease state generation outcome pending pane
	dir=$(sadir "$id")
	if ! lease=$(node "$STATE_HELPER" lease "$dir/lifecycle.json"); then
		echo "subagents: lifecycle for subagent #$id is missing or malformed; treating it as unknown/working" >&2
		return 2
	fi
	IFS=$'\t' read -r state generation <<<"$lease"
	case "$state" in
		awaiting-follow-up|blocked)
			if [ "$durable" = 0 ] && pending=$(node "$STATE_HELPER" pending "$dir/lifecycle.json" "$(sr)" 2>/dev/null); then
				local pstatus preport pevent ppath
				IFS=$'\t' read -r pstatus preport pevent ppath <<<"$pending"
				printf '%s\t%s\t%s\n' "$id" "$pstatus" "$preport"
				return 0
			fi
			return 1
			;;
		cleaned|stopped|exited) return 1 ;;
		starting|working) ;;
		*) echo "subagents: unknown lifecycle state for subagent #$id" >&2; return 2 ;;
	esac
	if [ ! -s "$dir/pane" ]; then
		echo "subagents: subagent #$id has no pane identity; treating it as unknown/working" >&2
		return 2
	fi
	pane=$(cat "$dir/pane")
	if ! pane_alive "$pane"; then
		publish_exit_locked "$id" "$generation"
		return $?
	fi
	# Publication is an explicit, generation-scoped CLI operation. A report file
	# by itself and pane stability are never completion signals.
	return 1
}

detect_and_emit() {
	local id="$1" durable="${2:-1}" dir rc
	dir=$(sadir "$id")
	[ -d "$dir" ] || return 1
	lock_acquire "$dir/.event.lock" "event consumer for subagent #$id"
	_emit_for_locked "$id" "$durable"; rc=$?
	lock_release
	return "$rc"
}

ack_event_locked() {
	local id="$1" event_id="$2" pending_path="$3"
	node "$STATE_HELPER" ack "$(sr)" "$id" "$event_id" "$pending_path" "$(date +%s)"
}

pull_ack() {
	local id="$1" dir pending status report event_id pending_path rc
	dir=$(sadir "$id")
	lock_acquire "$dir/.event.lock" "event consumer for subagent #$id"
	if pending=$(node "$STATE_HELPER" pending "$dir/lifecycle.json" "$(sr)" 2>/dev/null); then
		IFS=$'\t' read -r status report event_id pending_path <<<"$pending"
		ack_event_locked "$id" "$event_id" "$pending_path"; rc=$?
	else
		rc=0
	fi
	lock_release
	return "$rc"
}

# ---- cleanup --------------------------------------------------------------

cleanup_log() {
	local context="$1"; shift
	if [ "$context" = events ]; then echo "subagents cleanup: $*" >&2; else echo "cleanup: $*"; fi
}

cleanup_one() {
	local id="$1" context="$2" dir first second rc generation candidate_since event_id pane notice_key
	dir=$(sadir "$id")
	first=$(node "$STATE_HELPER" eligible "$dir/lifecycle.json" "$(sr)" "$(date +%s)" "$CLEANUP_GRACE_SECONDS"); rc=$?
	if [ "$rc" != 0 ]; then
		if [ "$rc" = 2 ]; then
			cleanup_log "$context" "subagent #$id has invalid lifecycle or delivery state; protected"
			CLEANUP_FAILURES=$((CLEANUP_FAILURES + 1))
		fi
		return 1
	fi
	# Phase two takes the same lease lock as publish, tell, retain, stop, and ack,
	# then repeats every eligibility and report-durability check.
	lock_acquire "$dir/.event.lock" "event consumer for subagent #$id"
	second=$(node "$STATE_HELPER" eligible "$dir/lifecycle.json" "$(sr)" "$(date +%s)" "$CLEANUP_GRACE_SECONDS"); rc=$?
	if [ "$rc" != 0 ]; then
		lock_release
		[ "$rc" = 2 ] && CLEANUP_FAILURES=$((CLEANUP_FAILURES + 1))
		return 1
	fi
	if [ "$first" != "$second" ]; then
		lock_release
		return 1
	fi
	IFS=$'\t' read -r generation candidate_since event_id <<<"$second"
	case "$CLEANUP_MODE" in
		dry-run)
			cleanup_log "$context" "would stop subagent #$id (completed, grace ${CLEANUP_GRACE_SECONDS}s elapsed)"
			CLEANUP_ACTIONS=$((CLEANUP_ACTIONS + 1))
			lock_release
			return 0
			;;
		notify)
			notice_key="$event_id:$candidate_since:$CLEANUP_GRACE_SECONDS"
			if node "$STATE_HELPER" notice-needed "$dir/lifecycle.json" "$notice_key"; then
				if lifecycle_transition "$id" notified "$generation" "$event_id" "$notice_key" >/dev/null; then
					cleanup_log "$context" "subagent #$id is eligible for cleanup (notify mode; no pane stopped)"
					CLEANUP_ACTIONS=$((CLEANUP_ACTIONS + 1))
				else
					CLEANUP_FAILURES=$((CLEANUP_FAILURES + 1))
				fi
			fi
			lock_release
			return 0
			;;
	esac
	if [ ! -s "$dir/pane" ]; then
		cleanup_log "$context" "subagent #$id lost its pane identity; protected"
		CLEANUP_FAILURES=$((CLEANUP_FAILURES + 1))
		lock_release
		return 1
	fi
	pane=$(cat "$dir/pane")
	if pane_alive "$pane"; then
		if ! tmux kill-pane -t "$pane" 2>/dev/null; then
			cleanup_log "$context" "could not stop pane for subagent #$id; lifecycle preserved"
			CLEANUP_FAILURES=$((CLEANUP_FAILURES + 1))
			lock_release
			return 1
		fi
	fi
	if ! lifecycle_transition "$id" cleaned "$generation" "$event_id" >/dev/null; then
		cleanup_log "$context" "pane for subagent #$id stopped but cleanup lifecycle commit failed"
		CLEANUP_FAILURES=$((CLEANUP_FAILURES + 1))
		lock_release
		return 1
	fi
	cleanup_log "$context" "stopped subagent #$id after completed report and ${CLEANUP_GRACE_SECONDS}s grace; state preserved"
	CLEANUP_ACTIONS=$((CLEANUP_ACTIONS + 1))
	lock_release
}

run_cleanup() {
	local context="$1" dir id
	CLEANUP_ACTIONS=0
	CLEANUP_FAILURES=0
	[ "$CLEANUP_MODE" != off ] || return 0
	for dir in "$(sr)"/*/; do
		[ -d "$dir" ] || continue
		id=$(basename "$dir")
		case "$id" in ''|*[!0-9]*) continue ;; esac
		cleanup_one "$id" "$context" || true
	done
	[ "$CLEANUP_FAILURES" = 0 ]
}

