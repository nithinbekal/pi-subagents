#!/usr/bin/env bash
#
# subagents — run helper agents in a dedicated tmux window and talk to them.
#
# Each subagent is an interactive `pi` running in its own pane of a tmux window
# named "subagents". You hand a subagent a complete task brief, watch it work,
# send follow-ups (answers / steering / nudges), and collect its final report.
#
# Subagents start with built-in tools only and without discovered context files,
# extensions, skills, or prompt templates. The lead supplies all task context
# directly and drives follow-ups over tmux send-keys + capture-pane.
#
# Launcher: subagents are started with `$SUBAGENTS_PI` (default "pi"). If your
# model provider needs a wrapper command to inject auth, set SUBAGENTS_PI to a
# trusted shell command such as `some-wrapper pi`.
#
# Session scoping: each tmux session gets its own subfolder under the state dir
# (named after the tmux session id, e.g. <state>/$3/<id>/), so commands and the
# watcher extension only ever see the current session's subagents — subagents
# spawned in other tmux sessions are invisible and protected.
#
# Usage:
#   subagents config                    Print resolved launcher, state, and window configuration.
#   subagents doctor                    Validate the launcher, tmux, and state layout.
#   subagents run [-m MODEL] [--effort LEVEL] <task...>
#                                       Start a subagent with a complete task brief. Prints its id.
#                                       -m/--model selects a provider-qualified model, e.g.
#                                       anthropic/claude-sonnet-4-6. Without it, Pi's current/default
#                                       model is inherited. --effort sets the thinking level.
#   subagents tell <id> <message...>    Send a follow-up message to a subagent.
#   subagents wait <id> [seconds]       Block until it finishes its task; print its report.
#   subagents events                    Print NEW completion events as TSV (id\tstatus\treportPath). Non-blocking. For the watcher extension.
#   subagents reap                      Print any newly-finished reports (non-blocking, human-friendly).
#   subagents status                    Show each subagent as working|idle|exited (non-blocking, no consume).
#   subagents peek <id> [lines]         Show the tail of a subagent's pane (watch it work).
#   subagents ls                        List active subagents.
#   subagents stop <id|--all>           Shut a subagent (or all) down (window closes when empty).

set -uo pipefail

PI_CMD="${SUBAGENTS_PI:-pi}"
STATE_DIR="${SUBAGENTS_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/subagents}"
WIN_PREFIX="${SUBAGENTS_WINDOW_NAME:-subagents}"
SENTINEL="@@DONE@@"
DEFAULT_WAIT=120
IDLE_POLLS=6   # consecutive unchanged polls before a subagent counts as idle

mkdir -p "$STATE_DIR"

die() { echo "subagents: $*" >&2; exit 1; }
in_tmux() { [ -n "${TMUX:-}" ]; }

# ---- tmux window / pane helpers -------------------------------------------

# Absolute path to a subagent's state dir within the current session.
sadir() { # id -> "$SR/<id>"
	local id="$1"
	[ -n "$id" ] || die "internal error: empty subagent id"
	printf '%s/%s' "$(sr)" "$id"
}

# Session scoping: state is partitioned into a per-session subfolder named after
# the tmux session id (e.g. $STATE_DIR/$3/<id>/), so every command — and the
# watcher extension — only ever sees subagents in the CURRENT tmux session. No
# cross-session leakage is possible, because other sessions' subagents live in
# sibling folders that nothing iterates into.
#
# Resolve the session id robustly: from $TMUX_PANE (targets the exact pane we
# run in), then from $TMUX ("socket,pid,<session-num>" -> "$<num>"), then last
# resort the active session. The $TMUX_PANE path is the reliable one; the others
# cover contexts where it is unset.
_CURRENT_SESSION=""
current_session_id() {
	[ -n "$_CURRENT_SESSION" ] && { printf '%s' "$_CURRENT_SESSION"; return 0; }
	if [ -n "${TMUX_PANE:-}" ]; then
		_CURRENT_SESSION=$(tmux display-message -pt "$TMUX_PANE" '#{session_id}' 2>/dev/null)
	fi
	if [ -z "$_CURRENT_SESSION" ] && [ -n "${TMUX:-}" ]; then
		local num; num=$(printf '%s' "$TMUX" | awk -F, '{print $3}')
		case "$num" in ''|*[!0-9]*) ;; *) _CURRENT_SESSION=\$"$num" ;; esac
	fi
	[ -n "$_CURRENT_SESSION" ] || _CURRENT_SESSION=$(tmux display-message -p '#{session_id}' 2>/dev/null)
	printf '%s' "$_CURRENT_SESSION"
}

valid_session_id() {
	local number
	case "$1" in \$*) number=${1#\$} ;; *) return 1 ;; esac
	case "$number" in ''|*[!0-9]*) return 1 ;; *) return 0 ;; esac
}
# Cached absolute path to the current session's state folder (created on demand).
# Cached so the per-call mkdir only happens once; sr() is safe to call in loops.
_SR=""
sr() {
	[ -n "$_SR" ] && { printf '%s' "$_SR"; return 0; }
	local session_id; session_id=$(current_session_id)
	[ -n "$session_id" ] || die "cannot determine current tmux session"
	_SR="$STATE_DIR/$session_id"; mkdir -p "$_SR"
	printf '%s' "$_SR"
}

subagents_windows() { # session -> all matching window ids
	tmux list-windows -t "$1" -F '#{window_id} #{window_name}' 2>/dev/null \
		| awk -v p="$WIN_PREFIX" '$2==p || index($2, p" (")==1 {print $1}'
}

subagents_window() { # session -> first matching window id (or empty)
	subagents_windows "$1" | head -1
}

pane_alive() { # pane_id
	tmux list-panes -a -F '#{pane_id} #{pane_dead}' 2>/dev/null \
		| awk -v p="$1" '$1==p{print $2}' | grep -qx 0
}

send_pane() { # pane_id message...
	local pane="$1"; shift
	local msg="$*"
	msg=${msg//$'\n'/ }   # collapse newlines: a bare Enter submits in pi
	tmux send-keys -t "$pane" -l -- "$msg"
	sleep 0.3
	tmux send-keys -t "$pane" Enter
}

# All CLI critical sections use the same atomic hard-link lock. The lock file
# contains the owner's pid, process identity, token, and acquisition time before
# it becomes visible. A lock is reclaimed only when that exact process is gone;
# age alone never breaks a live lock. The recovery hard link serializes
# competing reclaimers so they cannot both remove and replace the same lock.
LOCK_PATH=""
LOCK_TOKEN=""
LOCK_CANDIDATE=""

process_identity() { # pid -> stable identity for the lifetime of that process
	local identity
	identity=$(ps -o lstart= -p "$1" 2>/dev/null | cksum 2>/dev/null | awk '{print $1 ":" $2}')
	[ -n "$identity" ] && printf '%s\n' "$identity" || printf '%s\n' unknown
}

lock_record_valid() { # lock-file
	local owner_pid owner_identity owner_token owner_time
	[ -f "$1" ] || return 1
	read -r owner_pid owner_identity owner_token owner_time <"$1" 2>/dev/null || return 1
	case "$owner_pid" in ''|*[!0-9]*) return 1 ;; esac
	case "$owner_time" in ''|*[!0-9]*) return 1 ;; esac
	[ -n "$owner_identity" ] && [ -n "$owner_token" ]
}

lock_owner_abandoned() { # lock-file -> true only when its recorded owner is gone
	local lock="$1" owner_pid owner_identity owner_token owner_time current_identity
	lock_record_valid "$lock" || return 1
	read -r owner_pid owner_identity owner_token owner_time <"$lock"
	if ! kill -0 "$owner_pid" 2>/dev/null; then return 0; fi
	if [ "$owner_identity" != unknown ]; then
		current_identity=$(process_identity "$owner_pid")
		[ "$current_identity" != unknown ] && [ "$current_identity" != "$owner_identity" ] && return 0
	fi
	return 1
}

lock_owner_description() { # lock-file
	local owner_pid owner_identity owner_token owner_time
	read -r owner_pid owner_identity owner_token owner_time <"$1" 2>/dev/null || {
		printf '%s' "unreadable owner"; return
	}
	printf 'pid %s, acquired %s' "$owner_pid" "$owner_time"
}

recover_abandoned_lock() { # lock-file label
	local lock="$1" label="$2" recovery="${1}.recover" owner
	lock_owner_abandoned "$lock" || return 1

	# A recovery link that names a different inode is residue from a completed
	# takeover and can be removed without touching the current owner.
	if [ -e "$recovery" ] && ! { [ -f "$lock" ] && [ "$lock" -ef "$recovery" ]; }; then
		return 1
	fi
	[ ! -e "$recovery" ] || return 1
	ln "$lock" "$recovery" 2>/dev/null || return 1
	if [ ! "$lock" -ef "$recovery" ] || ! lock_owner_abandoned "$recovery"; then
		rm -f "$recovery" 2>/dev/null || true
		return 1
	fi

	owner=$(lock_owner_description "$recovery")
	rm -f "$lock" || { rm -f "$recovery" 2>/dev/null || true; return 1; }
	rm -f "$recovery" 2>/dev/null || true
	echo "subagents: recovered abandoned $label lock ($owner)" >&2
	return 0
}

lock_cleanup() {
	[ -z "$LOCK_CANDIDATE" ] || rm -f "$LOCK_CANDIDATE" 2>/dev/null || true
	LOCK_CANDIDATE=""
	lock_release
}

lock_release() {
	local owner_pid owner_identity owner_token owner_time
	[ -n "$LOCK_PATH" ] || return 0
	if read -r owner_pid owner_identity owner_token owner_time <"$LOCK_PATH" 2>/dev/null \
		&& [ "$owner_token" = "$LOCK_TOKEN" ]; then
		rm -f "$LOCK_PATH" 2>/dev/null || true
	fi
	LOCK_PATH=""; LOCK_TOKEN=""
}

lock_acquire() { # lock-file label
	local lock="$1" label="$2" attempts=0 owner_pid owner_identity
	[ -z "$LOCK_PATH" ] || die "internal error: nested CLI lock"
	[ ! -d "$lock" ] || die "unsupported lock directory at $lock; remove it after confirming no CLI is running"

	owner_pid=${BASHPID:-$$}
	owner_identity=$(process_identity "$owner_pid")
	LOCK_TOKEN="$owner_pid.$(date +%s).$RANDOM"
	LOCK_CANDIDATE="${lock}.candidate.$LOCK_TOKEN"
	printf '%s %s %s %s\n' "$owner_pid" "$owner_identity" "$LOCK_TOKEN" "$(date +%s)" >"$LOCK_CANDIDATE" \
		|| die "could not create $label lock candidate"
	trap 'lock_cleanup' EXIT
	trap 'lock_cleanup; exit 1' HUP INT TERM

	while :; do
		if ln "$LOCK_CANDIDATE" "$lock" 2>/dev/null; then
			LOCK_PATH="$lock"
			rm -f "$LOCK_CANDIDATE" 2>/dev/null || true
			LOCK_CANDIDATE=""
			return 0
		fi
		[ ! -d "$lock" ] || die "unsupported lock directory at $lock; remove it after confirming no CLI is running"
		if [ -e "$lock" ] && ! lock_record_valid "$lock"; then
			[ ! -e "$lock" ] || die "invalid $label lock record at $lock; refusing unsafe recovery"
		fi
		recover_abandoned_lock "$lock" "$label" && continue
		attempts=$((attempts + 1))
		if [ "$attempts" -ge 200 ]; then
			if lock_owner_abandoned "$lock"; then
				die "timed out recovering abandoned $label lock at $lock"
			fi
			die "timed out waiting for $label lock at $lock"
		fi
		sleep 0.05
	done
}

# Reserve a monotonically increasing id. The persistent counter survives
# `stop`/`stop --all`, so a later subagent never reuses an earlier subagent's id.
# Gaps after crashes are harmless.
reserve_id() {
	local root lock seq candidate tmp
	root=$(sr); lock="$root/.seq.lock"
	lock_acquire "$lock" "sequence"

	seq=$(cat "$root/.seq" 2>/dev/null || echo 0)
	case "$seq" in ''|*[!0-9]*) die "invalid subagent id counter at $root/.seq" ;; esac
	candidate=$((seq + 1))
	[ ! -e "$root/$candidate" ] || die "subagent id counter conflicts with existing agent #$candidate"
	tmp="$root/.seq.tmp.$$.$RANDOM"
	printf '%s\n' "$candidate" >"$tmp" || die "could not persist subagent id counter"
	mv "$tmp" "$root/.seq" || die "could not persist subagent id counter"
	mkdir "$root/$candidate" || die "could not create state for subagent #$candidate"

	lock_release
	printf '%s\n' "$candidate"
}

# Serialize the lookup/create/split sequence. A caller that waited for another
# launcher re-checks under the lock and reuses the winner's window.
create_subagent_pane() { # session command
	local session="$1" picmd="$2" lock win pane
	lock="$(sr)/.window.lock"
	lock_acquire "$lock" "tmux window"

	win=$(subagents_window "$session")
	if [ -z "$win" ]; then
		pane=$(tmux new-window -d -t "$session" -n "$WIN_PREFIX" -P -F '#{pane_id}' "$picmd") || return 1
	else
		pane=$(tmux split-window -d -t "$win" -P -F '#{pane_id}' "$picmd") || return 1
		tmux select-layout -t "$win" tiled >/dev/null 2>&1 || true
	fi
	lock_release
	printf '%s\n' "$pane"
}

write_protocol() { # result_path
	cat <<EOF
# Subagent protocol (important)

You are an autonomous helper running in a tmux pane. The task text passed when
you launch is your complete worker brief: it must contain all relevant context,
constraints, paths, and expected verification. Follow that brief directly, work
autonomously, and do not ask for confirmation on routine steps. A lead agent may
send follow-up messages with additional or replacement instructions.

The lead CANNOT see your screen. The only way it receives your work is the file
below, so you MUST end every task by writing to it:

1. Write your complete final answer/report to this file, overwriting it each task:
   $1
2. Then print a single line containing exactly: $SENTINEL
3. Then stop and wait for the next message, repeating these steps each time.

Never answer only in chat — always write the file first. If you get blocked and
need the lead's input, write what you need (plus any partial findings) to the
file, print $SENTINEL, and wait for the reply.
EOF
}

# ---- completion detection (shared by wait / events / reap) ----------------

# Snapshot a report to a new reports/<n>.md without advancing any completion
# marker. The event consumer lock serializes number selection. Existing files
# are never overwritten, including snapshots left by a crash before queueing.
SNAPSHOT_PATH=""
SNAPSHOT_NUMBER=""
snapshot() { # id source-file-or-empty
	local id="$1" src="$2" dir n out tmp
	dir=$(sadir "$id")
	n=$(cat "$dir/revent" 2>/dev/null || echo 0)
	case "$n" in ''|*[!0-9]*) n=0 ;; esac
	mkdir -p "$dir/reports" || return 1
	while :; do
		n=$((n + 1)); out="$dir/reports/$n.md"
		[ -e "$out" ] || break
	done
	tmp="$dir/reports/.$n.tmp.$$.$RANDOM"
	if [ -n "$src" ] && [ -s "$src" ]; then
		cp "$src" "$tmp" || return 1
	else
		{ tmux capture-pane -p -t "$(cat "$dir/pane")" 2>/dev/null \
			| grep -v '^[[:space:]]*$' || true; } | tail -40 >"$tmp" || return 1
	fi
	mv "$tmp" "$out" || return 1
	SNAPSHOT_PATH="$out"; SNAPSHOT_NUMBER="$n"
}

commit_snapshot_sequence() { # agent-dir
	printf '%s\n' "$SNAPSHOT_NUMBER" >"$1/revent"
}

sync_snapshot_sequence() { # agent-dir; recover a snapshot queued before a crash
	local dir="$1" report name max=0
	for report in "$dir"/reports/[0-9]*.md; do
		[ -f "$report" ] || continue
		name=$(basename "$report" .md)
		case "$name" in ''|*[!0-9]*) continue ;; esac
		[ "$name" -gt "$max" ] && max="$name"
	done
	[ "$max" -eq 0 ] || printf '%s\n' "$max" >"$dir/revent"
}

# Write the complete watcher record before a push consumer marker changes.
# The temp file and containing directory are fsynced around the atomic rename.
# A deterministic completion key makes replay deduplication independent of the
# snapshot path, including a crash after queueing but before marker persistence.
spool_completion() { # id status report-path completion-key spool-name
	local id="$1" status="$2" report_path="$3" completion_key="$4" spool_name="$5"
	local pending target
	pending="$(sr)/.watcher-pending"; target="$pending/$spool_name.json"
	mkdir -p "$pending" || return 1
	[ ! -f "$target" ] || return 0
	node - "$target" "$id" "$status" "$report_path" "$completion_key" <<'NODE'
const fs = require("node:fs");
const path = require("node:path");
const { randomUUID } = require("node:crypto");
const [target, id, status, reportPath, completionKey] = process.argv.slice(2);
const directory = path.dirname(target);
const reportBody = fs.readFileSync(reportPath, "utf8").trim();
const record = JSON.stringify({ id, status, reportPath, reportBody, completionKey });
const temporary = path.join(directory, `.${path.basename(target)}.${randomUUID()}.tmp`);
let descriptor;
try {
	descriptor = fs.openSync(temporary, "wx", 0o600);
	fs.writeFileSync(descriptor, record, "utf8");
	fs.fsyncSync(descriptor);
	fs.closeSync(descriptor);
	descriptor = undefined;
	if (fs.existsSync(target)) {
		fs.unlinkSync(temporary);
	} else {
		fs.renameSync(temporary, target);
	}
	const directoryDescriptor = fs.openSync(directory, "r");
	try { fs.fsyncSync(directoryDescriptor); } finally { fs.closeSync(directoryDescriptor); }
} catch (error) {
	if (descriptor !== undefined) fs.closeSync(descriptor);
	try { fs.unlinkSync(temporary); } catch {}
	throw error;
}
NODE
}

# Prepare and optionally durably queue one immutable completion. Returns:
#   0 = event printed, 2 = persistence failure, 3 = already queued by a prior
#   crashed invocation (no duplicate stdout; the watcher will replay the spool).
emit_completion() { # id status source completion-key spool-name durable
	local id="$1" status="$2" source="$3" completion_key="$4" spool_name="$5" durable="$6"
	local queued="$(sr)/.watcher-pending/$spool_name.json"
	if [ "$durable" = 1 ] && [ -f "$queued" ]; then return 3; fi
	if ! snapshot "$id" "$source"; then
		echo "subagents: could not snapshot completion for subagent #$id" >&2
		return 2
	fi
	if [ "$durable" = 1 ] && ! spool_completion "$id" "$status" "$SNAPSHOT_PATH" "$completion_key" "$spool_name"; then
		echo "subagents: could not durably queue completion for subagent #$id" >&2
		return 2
	fi
	commit_snapshot_sequence "$(sadir "$id")"
	printf '%s\t%s\t%s\n' "$id" "$status" "$SNAPSHOT_PATH"
	return 0
}

# Detect a NEW completion for one subagent and print a TSV line:
#   "<id>\t<status>\t<reportPath>"   (status = done | idle | exited)
# Push detection durably queues the immutable report before advancing the hash
# or exit marker. One consistent lock serializes watcher and pull consumers.
detect_and_emit() { # id durable(0|1)
	local id="$1" durable="${2:-0}" dir rc
	dir=$(sadir "$id")
	[ -d "$dir" ] && [ -f "$dir/pane" ] || return 1
	lock_acquire "$dir/.event.lock" "event consumer for subagent #$id"
	_emit_for "$id" "$durable"; rc=$?
	lock_release
	return "$rc"
}

_emit_for() { # id durable (runs holding the event consumer lock)
	local id="$1" durable="$2" dir pane emit_rc
	dir=$(sadir "$id"); pane=$(cat "$dir/pane")

	if ! pane_alive "$pane"; then
		[ -f "$dir/.exited" ] && return 1
		emit_completion "$id" "exited" "$dir/result.md" "$id:exited" "$id-exited" "$durable"
		emit_rc=$?
		case "$emit_rc" in
			0|3) : >"$dir/.exited"; [ "$emit_rc" = 3 ] && sync_snapshot_sequence "$dir"; return "$emit_rc" ;;
			*) return 2 ;;
		esac
	fi

	# A result-file completion is keyed on its content checksum. The watcher event
	# uses the same stable key, while the report path points at an immutable copy.
	if [ -s "$dir/result.md" ]; then
		local rhash curhash checksum bytes
		rhash=$(cat "$dir/rhash" 2>/dev/null || echo "")
		curhash=$(cksum <"$dir/result.md" 2>/dev/null)
		if [ "$curhash" != "$rhash" ]; then
			read -r checksum bytes <<<"$curhash"
			emit_completion "$id" "done" "$dir/result.md" "$id:done:$checksum:$bytes" \
				"$id-done-$checksum-$bytes" "$durable"
			emit_rc=$?
			case "$emit_rc" in
				0|3)
					printf '%s' "$curhash" >"$dir/rhash"
					echo 0 >"$dir/stable"; echo 0 >"$dir/saw"
					tmux capture-pane -p -t "$pane" 2>/dev/null | cksum >"$dir/rphash"
					[ "$emit_rc" = 3 ] && sync_snapshot_sequence "$dir"
					return "$emit_rc"
					;;
				*) return 2 ;;
			esac
		fi
	fi

	# Idle fallback: only a substantive inline answer that has gone quiet emits.
	local lhash stable saw rphash cur
	lhash=$(cat "$dir/lhash" 2>/dev/null || echo "")
	stable=$(cat "$dir/stable" 2>/dev/null || echo 0)
	saw=$(cat "$dir/saw" 2>/dev/null || echo 0)
	rphash=$(cat "$dir/rphash" 2>/dev/null || echo "")
	cur=$(tmux capture-pane -p -t "$pane" 2>/dev/null | cksum)
	if [ "$cur" != "$lhash" ]; then stable=0; saw=1; else stable=$((stable + 1)); fi
	echo "$cur" >"$dir/lhash"; echo "$stable" >"$dir/stable"; echo "$saw" >"$dir/saw"
	if [ "$stable" -ge "$IDLE_POLLS" ] && [ "$saw" = 1 ] && [ "$cur" != "$rphash" ] && [ ! -s "$dir/result.md" ]; then
		local cap meaningful pane_checksum pane_bytes idle_source
		cap=$(tmux capture-pane -p -t "$pane" 2>/dev/null | grep -v '^[[:space:]]*$')
		meaningful=$(printf '%s\n' "$cap" | grep -vcE '^[[:space:]]*[][(){}<>=_~|*-]*[─│]*[[:space:]]*$|pi v[0-9]|Package Updates|Press ctrl|escape interrupt|Model scope|Pi can explain|Update Available|Changelog|Run pi update|^\[(Context|Themes|Skills|Prompts)\]')
		if [ "${meaningful:-0}" -ge 3 ]; then
			read -r pane_checksum pane_bytes <<<"$cur"
			idle_source="$dir/.idle-report.tmp.$$.$RANDOM"
			printf '%s\n' "$cap" | tail -40 >"$idle_source"
			emit_completion "$id" "idle" "$idle_source" "$id:idle:$pane_checksum:$pane_bytes" \
				"$id-idle-$pane_checksum-$pane_bytes" "$durable"
			emit_rc=$?; rm -f "$idle_source"
			case "$emit_rc" in
				0|3)
					echo "$cur" >"$dir/rphash"; echo 0 >"$dir/saw"
					[ "$emit_rc" = 3 ] && sync_snapshot_sequence "$dir"
					return "$emit_rc"
					;;
				*) return 2 ;;
			esac
		fi
	fi
	return 1
}

# ---- commands -------------------------------------------------------------

provider_model() { # model -> true when provider-qualified
	local model="$1" provider model_id
	provider=${model%%/*}; model_id=${model#*/}
	[ "$provider" != "$model" ] && [ -n "$provider" ] && [ -n "$model_id" ]
}

cmd_config() {
	printf 'launcher=%s\n' "$PI_CMD"
	printf 'state_dir=%s\n' "$STATE_DIR"
	printf 'window_name=%s\n' "$WIN_PREFIX"
}

cmd_doctor() {
	local failures=0 warnings=0 orphan_sessions=0 root count dir name pane pane_session launcher_bin session_id
	local -a launcher_parts=()
	in_tmux || { echo "FAIL tmux: not in a tmux session"; return 1; }
	session_id=$(current_session_id); root=$(sr)

	read -r -a launcher_parts <<<"$PI_CMD"
	launcher_bin="${launcher_parts[0]:-}"
	if [ -n "$launcher_bin" ] && command -v "$launcher_bin" >/dev/null 2>&1; then
		echo "ok   launcher: $launcher_bin"
	else
		echo "FAIL launcher: command not found: ${launcher_bin:-<empty>}"
		failures=$((failures + 1))
	fi

	count=$(subagents_windows "$session_id" | awk 'NF{n++} END{print n+0}')
	if [ "$count" -le 1 ]; then
		echo "ok   window: ${count} subagents window(s) in $session_id"
	else
		echo "FAIL window: $count subagents windows in $session_id (expected at most 1)"
		failures=$((failures + 1))
	fi

	# The watcher resolves exactly $STATE_DIR/<literal tmux session_id>/<numeric id>.
	if ! valid_session_id "$session_id"; then
		echo "FAIL state: unexpected tmux session id '$session_id'"
		failures=$((failures + 1))
	fi
	for dir in "$STATE_DIR"/*/; do
		[ -d "$dir" ] || continue
		name=$(basename "$dir")
		if ! valid_session_id "$name"; then
			echo "FAIL state: unexpected root entry $dir"
			failures=$((failures + 1)); continue
		fi
		if ! tmux list-sessions -F '#{session_id}' 2>/dev/null | grep -Fqx "$name"; then
			orphan_sessions=$((orphan_sessions + 1))
		fi
	done
	if [ "$orphan_sessions" -gt 0 ]; then
		echo "WARN state: $orphan_sessions orphaned tmux session dir(s) under $STATE_DIR"
		warnings=$((warnings + 1))
	fi
	local lock_path lock_label
	for lock_path in "$root/.seq.lock" "$root/.window.lock"; do
		case "$lock_path" in *.seq.lock) lock_label="sequence" ;; *) lock_label="tmux window" ;; esac
		if [ -e "$lock_path" ]; then
			if lock_owner_abandoned "$lock_path"; then
				echo "WARN state: abandoned $lock_label lock ($(lock_owner_description "$lock_path"))"
				warnings=$((warnings + 1))
			elif ! lock_record_valid "$lock_path"; then
				echo "FAIL state: unsupported or invalid $lock_label lock at $lock_path"
				failures=$((failures + 1))
			fi
		fi
		if [ -e "$lock_path.recover" ]; then
			echo "WARN state: incomplete $lock_label lock recovery at $lock_path.recover"
			warnings=$((warnings + 1))
		fi
	done
	for dir in "$root"/*/; do
		[ -d "$dir" ] || continue
		name=$(basename "$dir")
		case "$name" in *[!0-9]*|'')
			echo "FAIL state: non-numeric agent dir $dir"
			failures=$((failures + 1)); continue ;;
		esac
		if [ ! -s "$dir/pane" ] || [ ! -s "$dir/protocol.md" ] || [ ! -s "$dir/task" ] || [ ! -f "$dir/result.md" ]; then
			echo "FAIL state: incomplete agent dir $dir"
			failures=$((failures + 1)); continue
		fi
		lock_path="$dir/.event.lock"
		if [ -e "$lock_path" ]; then
			if lock_owner_abandoned "$lock_path"; then
				echo "WARN state: abandoned event consumer lock for agent #$name ($(lock_owner_description "$lock_path"))"
				warnings=$((warnings + 1))
			elif ! lock_record_valid "$lock_path"; then
				echo "FAIL state: unsupported or invalid event consumer lock at $lock_path"
				failures=$((failures + 1))
			fi
		fi
		if [ -e "$lock_path.recover" ]; then
			echo "WARN state: incomplete event consumer lock recovery for agent #$name"
			warnings=$((warnings + 1))
		fi
		pane=$(cat "$dir/pane")
		pane_session=$(tmux display-message -pt "$pane" '#{session_id}' 2>/dev/null || true)
		if [ -z "$pane_session" ]; then
			echo "WARN state: orphaned agent #$name (pane $pane is gone)"
			warnings=$((warnings + 1))
		elif [ "$pane_session" != "$session_id" ]; then
			echo "FAIL state: agent #$name pane belongs to $pane_session, not $session_id"
			failures=$((failures + 1))
		fi
	done
	[ "$failures" -gt 0 ] || echo "ok   state: watcher-compatible layout at $root"

	if [ "$failures" -gt 0 ]; then
		echo "doctor: $failures failure(s), $warnings warning(s)"
		return 1
	fi
	if [ "$warnings" -gt 0 ]; then
		echo "doctor: healthy, $warnings warning(s)"
	else
		echo "doctor: healthy"
	fi
}

cmd_run() {
	local model_override="" effort_override=""
	while [ $# -gt 0 ]; do
		case "$1" in
			-m|--model)
				[ $# -ge 2 ] && [ -n "$2" ] || die "$1 needs a value"
				model_override="$2"; shift 2 ;;
			--effort)
				[ $# -ge 2 ] && [ -n "$2" ] || die "--effort needs a value"
				effort_override="$2"; shift 2 ;;
			--) shift; break ;;
			-*) die "unknown option '$1'" ;;
			*) break ;;
		esac
	done
	local task="$*"
	[ -n "$task" ] || die "usage: subagents run [-m MODEL] [--effort LEVEL] <task...>"
	in_tmux || die "subagents requires tmux"
	if [ -n "$model_override" ] && ! provider_model "$model_override"; then
		die "model '$model_override' is not provider-qualified (expected provider/model)"
	fi

	local session_id; session_id=$(current_session_id)
	local id; id=$(reserve_id) || die "failed to reserve subagent id"
	case "$id" in ''|*[!0-9]*) die "failed to reserve subagent id" ;; esac
	local dir; dir=$(sadir "$id")
	[ -d "$dir" ] || die "failed to reserve subagent id"
	local result="$dir/result.md"
	: >"$result"
	write_protocol "$result" >"$dir/protocol.md"

	local q_pwd q_proto q_task q_model q_effort
	q_pwd=$(printf %q "$PWD")
	q_proto=$(printf %q "$dir/protocol.md")
	q_task=$(printf %q "$task")

	local picmd="cd $q_pwd && exec $PI_CMD --no-extensions --no-skills --no-prompt-templates --no-context-files --no-session"
	if [ -n "$model_override" ]; then
		q_model=$(printf %q "$model_override")
		picmd="$picmd --model $q_model"
	fi
	if [ -n "$effort_override" ]; then
		q_effort=$(printf %q "$effort_override")
		picmd="$picmd --thinking $q_effort"
	fi
	picmd="$picmd --append-system-prompt $q_proto $q_task"

	local pane
	if ! pane=$(create_subagent_pane "$session_id" "$picmd") || [ -z "$pane" ]; then
		rm -rf "$dir"
		die "failed to create subagent pane"
	fi

	echo "$pane" >"$dir/pane"
	printf '%s\n' "$task" >"$dir/task"
	tmux select-pane -t "$pane" -T "subagent#$id" 2>/dev/null || true

	echo "started subagent #$id — pane $pane, model ${model_override:-inherited}${effort_override:+, effort $effort_override}"
	echo "  report:  pushed by subagents-watch — end your turn"
	echo "  answer:  subagents tell $id <message>"
	echo "  fallback without watcher: subagents wait $id"
}

cmd_tell() {
	local id="${1:-}"; shift || true
	local msg="$*"
	[ -n "$id" ] && [ -n "$msg" ] || die "usage: subagents tell <id> <message...>"
	local dir; dir=$(sadir "$id"); [ -d "$dir" ] || die "no subagent #$id"
	local pane; pane=$(cat "$dir/pane")
	pane_alive "$pane" || die "subagent #$id is not running"
	send_pane "$pane" "$msg"
	echo "sent to subagent #$id"
}

cmd_wait() {
	local id="${1:-}"; local secs="${2:-$DEFAULT_WAIT}"
	[ -n "$id" ] || die "usage: subagents wait <id> [seconds]"
	[ -d "$(sadir "$id")" ] || die "no subagent #$id"
	local i line status path
	for ((i = 0; i < secs; i += 2)); do
		if line=$(detect_and_emit "$id") && [ -n "$line" ]; then
			IFS=$'\t' read -r _ status path <<<"$line"
			echo "=== subagent #$id report ($status) ==="
			[ -s "$path" ] && cat "$path" || echo "(no report captured)"
			return 0
		fi
		sleep 2
	done
	echo "[subagent #$id still working after ${secs}s — 'subagents peek $id' to watch, 'subagents tell $id <msg>' to steer]"
	return 1
}

# Print NEW completion events for THIS SESSION's subagents as TSV (one pass,
# non-blocking). Iterating the per-session folder is the scoping mechanism —
# other sessions' subagents live in sibling folders and are never visited.
cmd_events() {
	local dir id rc failures=0
	for dir in "$(sr)"/*/; do
		[ -d "$dir" ] || continue
		id=$(basename "$dir"); [ -f "$dir/pane" ] || continue
		detect_and_emit "$id" 1; rc=$?
		[ "$rc" = 2 ] && failures=$((failures + 1))
	done
	[ "$failures" = 0 ] || return 1
}

pull_events() {
	local dir id rc failures=0
	for dir in "$(sr)"/*/; do
		[ -d "$dir" ] || continue
		id=$(basename "$dir"); [ -f "$dir/pane" ] || continue
		detect_and_emit "$id" 0; rc=$?
		[ "$rc" = 2 ] && failures=$((failures + 1))
	done
	[ "$failures" = 0 ] || return 1
}

# Human-friendly drain of newly-finished reports.
cmd_reap() {
	local any=0 id status path
	while IFS=$'\t' read -r id status path; do
		[ -n "$id" ] || continue
		any=1
		echo "=== subagent #$id — $status ==="
		[ -s "$path" ] && cat "$path" || echo "(no report captured)"
		echo
	done < <(pull_events)
	[ "$any" = 1 ] || echo "no new reports"
}

# Non-blocking live status of each subagent (does not consume events).
cmd_status() {
	local dir id pane st found=0 h1 h2
	for dir in "$(sr)"/*/; do
		[ -d "$dir" ] || continue
		id=$(basename "$dir"); [ -f "$dir/pane" ] || continue
		pane=$(cat "$dir/pane")
		if ! pane_alive "$pane"; then
			st="exited"
		else
			h1=$(tmux capture-pane -p -t "$pane" 2>/dev/null | cksum); sleep 0.4
			h2=$(tmux capture-pane -p -t "$pane" 2>/dev/null | cksum)
			[ "$h1" = "$h2" ] && st="idle" || st="working"
		fi
		printf "#%-3s %s\n" "$id" "$st"; found=1
	done
	[ "$found" = 1 ] || echo "no subagents"
}

cmd_peek() {
	local id="${1:-}"; local lines="${2:-40}"
	[ -n "$id" ] || die "usage: subagents peek <id> [lines]"
	local dir; dir=$(sadir "$id"); [ -d "$dir" ] || die "no subagent #$id"
	local pane; pane=$(cat "$dir/pane")
	pane_alive "$pane" || { echo "[subagent #$id not running]"; return 0; }
	tmux capture-pane -p -t "$pane" | grep -v '^[[:space:]]*$' | tail -"$lines"
}

cmd_ls() {
	local dir id pane st task found=0
	for dir in "$(sr)"/*/; do
		[ -d "$dir" ] || continue
		id=$(basename "$dir")
		[ -f "$dir/pane" ] || continue
		pane=$(cat "$dir/pane")
		if pane_alive "$pane"; then st="alive"; else st="dead"; fi
		task=$(head -c 64 "$dir/task" 2>/dev/null | tr '\n' ' ')
		printf "#%-3s %-6s %s\n" "$id" "$st" "$task"
		found=1
	done
	[ "$found" = 1 ] || echo "no subagents"
}

cmd_stop() {
	local target="${1:-}"
	[ -n "$target" ] || die "usage: subagents stop <id|--all>"
	if [ "$target" = "--all" ]; then
		local dir id pane
		for dir in "$(sr)"/*/; do
			[ -d "$dir" ] || continue
			id=$(basename "$dir")
			[ -f "$dir/pane" ] || continue
			pane=$(cat "$dir/pane")
			tmux kill-pane -t "$pane" 2>/dev/null || true
			rm -rf "$dir"
			echo "stopped subagent #$id"
		done
	else
		local dir; dir=$(sadir "$target"); [ -d "$dir" ] || die "no subagent #$target"
		local pane; pane=$(cat "$dir/pane")
		tmux kill-pane -t "$pane" 2>/dev/null || true
		rm -rf "$dir"
		echo "stopped subagent #$target"
	fi
}

usage() { awk 'NR>1 && /^#/{sub(/^# ?/,""); print; next} NR>1 && !/^#/{exit}' "$0"; }

# ---- dispatch -------------------------------------------------------------

cmd="${1:-}"; shift || true
case "$cmd" in
	config)    cmd_config "$@" ;;
	doctor)    cmd_doctor "$@" ;;
	run)       cmd_run   "$@" ;;
	tell)      cmd_tell  "$@" ;;
	wait)      cmd_wait  "$@" ;;
	events)    cmd_events "$@" ;;
	reap)      cmd_reap  "$@" ;;
	status)    cmd_status "$@" ;;
	peek)      cmd_peek  "$@" ;;
	ls)        cmd_ls    "$@" ;;
	stop)      cmd_stop  "$@" ;;
	""|-h|--help|help) usage ;;
	*) die "unknown command '$cmd' (try: subagents --help)" ;;
esac
